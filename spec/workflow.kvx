[meta]
name = "Gideon UI Rebuild Fleet"
active_feature = "gideon-ui-rebuild"
source_of_truth = "spec/gideon-ui-rebuild/spec.kvx"

[mode]
name = "parallel"

[limits]
max_in_progress = 20

[agents]
driver = "codex"
max = 20
ttl = 14400
codex_args = "--model gpt-6-sol"

[hierarchy]
enabled = true
main = "main"
remote = "origin"
worktrees = ".codegraph/worktrees"
test_gate = "python3 tooling/ui_quality_gate.py --integration"
lint_gate = "git diff --check HEAD^ HEAD"
pr = "manual"
checkpoint = "manual"

[role.main]
title = "UI Fleet Leader"
agent = "gu26-leader"
branch = "{main}"
base = ""

[role.feature]
title = "UI Feature Manager"
agent = "gu26-manager-{feature}"
branch = "feature/{feature}"
base = "{main}"
model = "gpt-6-sol"

[role.worker]
title = "UI Feature Worker"
agent = "gu26-worker-{feature}-{wave}"
branch = "wave/{feature}/{wave}"
base = "feature/{feature}"
model = "gpt-6-sol"

[fleet.members]
leader = "gu26-leader"
feature_managers = ["gu26-fm01", "gu26-fm02", "gu26-fm03", "gu26-fm04"]
manager_model = "gpt-6-sol"
worker_model = "gpt-6-sol"
subagent_count = 20
worker_count = 16

[fleet.dispatch]
phase = "implementation"
workers_started = true
requires = "Independent implementation active; commits use enforced helper; dependent integration waits for committed source and dependency contracts"

[hard_rules]
source_of_truth = "Root owns master statuses. Lane specs mirror task contracts; cross-feature prerequisites in master remain mandatory."
hosted = "Preserve current authentication, tenant boundaries, deep links, subscriptions and operator-managed model/provider/infrastructure policy. Models/context/usage remain visible where truthful; privileged provider credentials, local installs and runtime administration stay operator-owned. OSS retains configuration. Read-only/disabled hosted variants must explain actual availability, never silently remove the requested component from the traceability map."
commits = "Before first implementation commit install scoped commit helper, prepare-commit-msg/commit-msg validation and pre-integration/pre-push all-commit audit. Validate identity sequence, exact format, date, branch at creation, staged tree and footer; existing history exempt by recorded baselines. No --no-verify, skipped hooks, forced acceptance or rewriting prior history. No commits during spec preparation before this prerequisite."
publication = "Each checkout stays isolated; preserve preexisting modifications. Qualified worker -> manager via cg fleet merge-up -> root main via cg fleet land. Leader alone pushes OSS origin/main as integrated commits land. Hosted commits remain local. Current phase has no production deploy or service replacement."
quality = "Source copied, component exported, showcase rendered, tests written, tests passed, integrated and live journey proven are distinct states. All requested consumers and metrics must pass before complete."

