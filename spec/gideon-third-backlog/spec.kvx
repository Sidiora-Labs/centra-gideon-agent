# gideon-third-backlog — feature spec. Requirements, design, then the task list.

[meta]
feature = "gideon-third-backlog"
status  = "draft"
intro   = "This specification converts the 82 actionable work items in 3rd-todo.md into traceable requirements and pending implementation tasks across Gideon."

[qualification.test_dependencies]
status = "implemented-not-fully-qualified"
implementation = "Declare setuptools>=64 in the test extra and regenerate uv.lock; install locked setuptools 83.0.0 in wt/base/.venv."
evidence = "e125ffd51e7686157b9c5b19a7959d1e66ab6829 + working-tree dependency fix; .venv/bin/python -m pytest checks/runtime/test_sdist_bundles_spa.py -q; exit 0; /tmp/gideon-setuptools-test.log"
remaining = "Focused gate: 3 passed, 1 skipped because apps/console/dist is absent. Full make test and built-console packaging coverage remain unqualified; no merge, commit or push performed."

[qualification.merge_failure_repairs]
status = "implemented-not-fully-qualified"
implementation = "Repair recorded runtime failures after package extraction and active backlog changes: shared request validation and error envelopes, persisted inbox and snapshot data, permission ceilings, capture learning admission, structural and protocol inventories, packaging and installer paths, generated API reference, and reachable memory/knowledge conflict review. Preserve the original acceptance assertions with real request/type fixtures."
evidence = "Focused repair reports and logs: /tmp/gideon-repair-agents/*.result.json; resumed parallel batch: /tmp/gideon-resume-focused.log. Source e125ffd51e7686157b9c5b19a7959d1e66ab6829 plus uncommitted active-spec work and repairs."
remaining = "Final parallel runtime suite and browser build qualification pending. Target working-tree transfer authorized to /root/openapi/centra-gideon-agent; preserve target edits, do not stage, commit or push."

[design]
overview = "Implement the third Gideon backlog as independently traceable vertical slices. Each task owns one source work item and preserves every nested source bullet as a distinct acceptance criterion."

[design.traceability]
note = "Requirement and task numbering follow source order. Source headings become task sections; repeated external identifiers remain separate requirements when 3rd-todo.md describes separate deliverables."

[design.delivery]
note = "All implementation tasks begin pending in wave 0 because the source declares no ordering dependencies. Each slice must deliver its backend, surface, SDK, evaluation, documentation, and focused regression obligations wherever its acceptance criteria name them."

[documentation]
mode      = "auto"
status    = "pending"
audiences = ["user", "developer"]
targets   = ["README.md", "docs/**", "CONTRIBUTING.md", "CHANGELOG.md"]

[tasks]
heading = "Implementation Plan: gideon-third-backlog"

[req.1]
title = "KBVS-2 — Relevance reranker stage (off by default)"
story = "As a knowledge user, I want KBVS-2 — Relevance reranker stage (off by default) delivered so that the documented behavior is complete, observable, and regression-protected."
ac_1 = "Add a post-fusion relevance stage to `HybridRetriever`, gated by `knowledge.rerank_enabled` (default `false`)."
ac_2 = "Send top RRF-fused candidates to the active reasoning model via the existing `one_shot_completion` seam — no vendor branch in core."
ac_3 = "On model failure, empty response, or response naming no real candidate ID: fail open to the un-reranked order."
ac_4 = "Extend `gideon.evals.retrieval_bench` to measure the rerank arm as its own `\"rerank\"` row alongside keyword/graph/vector. The row reads `\"not measured\"` when the reranker never gets a usable response."
ac_5 = "Register `knowledge/retrieval.py` in the degraded-contract lint map (`assistant_reasoning`, fail-open floor)."
ac_6 = "Fix stale `config-baseline.json` so the new config keys pass the config-baseline gate."
ac_7 = "Add a falsifier test: score one corpus twice with the model ordering changed and assert the bench row moves (1.0 → 0.0). A mutation that ignores the model's ordering must red."

[task.1]
title   = "KBVS-2 — Relevance reranker stage (off by default)"
section = "Knowledge / Retrieval"
status  = "done"
wave    = 0
reqs    = ["1.1", "1.2", "1.3", "1.4", "1.5", "1.6", "1.7"]
do_1    = "Implement every acceptance criterion for requirement 1 as one complete vertical slice"
do_2    = "Add or update focused regression coverage and any explicit rails required by requirement 1"

