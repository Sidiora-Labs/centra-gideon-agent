[req.9]
title = "KBVS-1 — External vector-store backend seam"
story = "As a knowledge user, I want KBVS-1 — External vector-store backend seam delivered so that the documented behavior is complete, observable, and regression-protected."
ac_1 = "Add a provider seam so an external vector store (e.g. Qdrant) can replace the local `vec0` index for chunk similarity search."
ac_2 = "The contract: external store computes cosine similarity in [−1, 1], returns results in descending order; core applies its own `_VECTOR_MIN_SIMILARITY` floor, MAX roll-up, liveness join and RRF fusion."
ac_3 = "A bound-but-unreachable backend contributes nothing (WARNING log); keyword/graph/whole-item arms still answer. No fallback to `vec0` from a failed external store."
ac_4 = "Write-through: hook the three chunk-write sites (`replace_chunks`, `clear_chunks`, `_delete_item_cascade`) to immediately index/delete on the external store per item. Swallow write failures at WARNING."
ac_5 = "Add `PROVIDER_TYPES` entry + `VectorStoreTypeHandler`; regenerate `reference/providers.md`."
ac_6 = "Rels: forbid vendor-specific constants (host, port, API key) in `retrieval.py`; verify output byte-identity between the branch and its merge base over 7 queries × archived/unarchived."

