[req.26]
title = "#411 — Launching from Plan Review preserves unmodeled `kind_config` fields"
story = "As a task and loop user, I want #411 — Launching from Plan Review preserves unmodeled `kind_config` fields delivered so that the documented behavior is complete, observable, and regression-protected."
