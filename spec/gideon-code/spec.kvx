[meta]
feature = "gideon-code"
title = "Extract Gideon's reusable core into a focused CLI coding agent"
status = "pending"
version = "0.2.0-draft"
created_at = "2026-10-27"
source_of_truth = "spec/gideon-code/spec.kvx"
inspection_revision = "0ce97a341945aeed5052115b66c4d230b07ab3cd"
qualification_status = "not_run"
authorization = "On 2026-10-27 the user explicitly instructed implementation by subagents with the root supervising. Extraction and focused packet qualification are authorized. Pruning still requires separate manifest-digest-bound approval; release/deployment authority is not implied."


[design.normative_pack]
entrypoint = "README.md provides reading order; spec.kvx owns requirement and task identities/status. runtime-contract.md, storage-context.md, tools-security.md, delegation-extensions.md, extraction-cutover.md and verification-evaluation.md refine normative behavior. traceability.md maps every acceptance clause to tasks."
precedence = "Direct user instruction outranks this pack. Within this pack an explicit KVX acceptance clause outranks a conflicting chapter; all conflicts block the affected task until one coherent spec revision resolves them. Chapters cannot silently expand product scope or relax mandatory gates."
reference_examples = "Authoring depth follows /root/hyperfide/spec/hyperfide, hyperfide-v21 and hyperfide-v22 inspected on 2026-10-27. Those repositories' operational policies, deployment requirements and historical approvals are not imported. The attached file_spec.kvx is byte-identical to the initial 565-line Gideon draft."
contract_maturity = "All schemas, thresholds, default limits, scenarios and implementation instructions in this revision are proposed normative contracts; all runtime cases remain UNRUN. Authoring checks only validate this specification pack."

[decisions]
d_1 = "Confirmed direction from user transcript: reusable-core extraction replaces additive platform development; focused CLI product; remove irrelevant platform only after standalone proof."
d_2 = "Proposed staging: lean/ is an independent distribution in the same Git repository, followed by exact-manifest promotion at cutover. This avoids invoking old setup.py hooks or prematurely deleting source fixtures."
d_3 = "Proposed authority: one local session journal plus explicit process ownership; no PostgreSQL, fleet daemon or distributed coordination layer. Derived indexes and terminal projections cannot grant effect authority."
d_4 = "Proposed compatibility: preserve exact-edit and shell-first behavior initially; apply_patch, background handles, interactive commands and delegated work are versioned later extensions, not reasons to rewrite immutable original vectors."
d_5 = "Confirmed boundary: user implementation authorization on 2026-10-27 supersedes prior planning-only metadata. Future pruning still requires new explicit approval bound to a prepared manifest; publication follows applicable repository guards and the authorized task scope."
d_6 = "Proposed qualification: real paths for effects and real providers for capability; recorded wire fixtures may establish parser contracts only. No fake provider can prove model competence or end-to-end success."
d_7 = "Proposed product defaults and scope are reviewable in the chapter contracts. Any unsupported OS/backend/provider capability remains explicit rather than being emulated as a success."

[design.intent]
outcome = "From a repository directory, run a local coding agent that explores, edits, executes checks, resumes work and reports evidence without a gateway or personal-assistant platform."
strategy = "Extract into an independently packaged lean/ subtree in this repository. Preserve the original implementation until the extracted consumer passes its carried contracts and real-provider journeys. Promote the proven package at the separately approved prune boundary."
non_goals = ["Personal knowledge graph", "Messaging channels", "Automation scheduler", "Hosted gateway", "Dashboard or desktop/mobile apps", "Hypermid service", "ACP as the primary agent", "Core language rewrite", "Automatic migration or deletion of personal state"]
scope_control = "This spec supersedes the transcript's additive CLI proposal and layer-by-layer extraction sequence. Existing feature specs remain historical and are neither edited nor marked done by this plan."

[design.evidence]
headless = "runtime/gideon/interfaces/cli/run.py already implements gateway-backed headless formats. The gap is gateway-free execution, not absence of print output."
packaging = "setup.py invokes Hypermid and console build paths; pyproject.toml discovers all gideon packages. A separate lean/pyproject.toml must not execute these hooks or discover runtime/gideon."
coupling = "sandbox.py lazily loads config, installer and network policy; turn_checkpoints.py loads configuration and sensitive-path policy; context_compaction.py references resume_account; llm/__init__.py eagerly loads other providers. None is presumed isolated because its top-level imports look small."
existing_tools = "CodeMapToolProvider is already registered in runtime/gideon/integrations/tool_providers/registry.py. Rehome this consumer and its parser/cache boundary instead of building a competing symbol index."
hypermid = "Default-off is not import independence: native runtime construction imports Hypermid providers. Remove constructor and package-initializer reachability before deletion."
process = "cg brief/survey/context report no initialized Codify project; cg spec lint reports missing spec/workflow.kvx. Do not initialize Codify or invent workflow files during planning. Task activation tooling is an implementation preflight decision."
uncertainty = "Inspection is static evidence, not successful execution. No claimed runtime pass, reuse percentage, target line count prediction or provider availability follows from this document."

[design.layout]
staging = "lean/pyproject.toml; lean/src/gideon_code/{cli,agent,providers,tools,security,context,session}; lean/checks; lean/checks/carried; lean/scripts. Existing root manifests remain untouched before cutover."
entrypoint = "gideon-code -p PROMPT [--cwd PATH] [--resume ID] [--format text|jsonl]; gideon-code without -p starts the interactive session. The installed entry point constructs the same in-process runtime in both modes."
state = "Use XDG_CONFIG_HOME/gideon-code for explicit configuration and XDG_STATE_HOME/gideon-code for versioned sessions/checkpoints, with standard home fallbacks. No GIDEON_HOME dependency or implicit .local_secret reads."
config = "CLI flags override explicit project/user configuration, then environment/defaults. Credentials use named environment references; never persist resolved credentials in sessions, traces or printed config. Preserve usable existing provider settings through an explicit reviewed import, not silent discovery of secrets."
dependency_direction = "CLI -> agent -> provider/tool/context/session contracts. Tools -> permission policy -> workspace/process adapters. Core imports only the new package and declared dependencies; zero runtime/gideon imports, lazy imports included."
promotion = "After the approved deletion manifest, move the independently installed package to the final root layout in the same cutover, updating paths and commands explicitly. Never leave a lean wrapper importing the archived platform."

[design.reuse]
keep_first = ["native/read_gate.py", "native/dispatch_plan.py", "LLM base/events/prompt-cache/stream contracts", "tool_providers/base.py", "core atomic-write/cancellation/error/token primitives"]
adapt = ["native/runtime.py", "native/builtin_tools.py coding verbs", "native/workspace_access.py", "native/approval.py decision delivery", "security/sandbox.py and shell/path policies", "engine/turn_checkpoints.py", "cognition/context_compaction.py", "LLM anthropic/openai providers", "assurance/codegraph parser/index and code-map tool provider", "MCP client and local skill loader"]
replace = ["Gateway session directory with scoped append-only conversation store adapted from engine/session_workspace.py primitives where suitable", "Gateway CLI transport with local CLI consumer", "Platform config/provider registry with explicit small factory"]
policy = "Keep algorithms and behavioral contracts; replace platform ownership adapters. ApprovalGate delivers decisions but is not a complete permission policy. Preserve full-content pre-edit evidence and conflict-aware dispatch. Do not weaken the sandbox to make extraction pass."

[design.removal]
candidates = ["apps/", "crates/", "runtime/gideon/", "sdk/", "platform-only scripts and deployment assets", "Root Node/Rust manifests and lockfiles", "Platform-only checks and translated documentation"]
classification = "These are candidate families, not an executable deletion list. Freeze task inventories every tracked path as retain, adapt, archive or remove, including licenses, attribution, fixtures, CI, packaging and active instruction files. Unknown and shared paths block deletion."
archive = "Before deletion create archive/gideon-platform and pre-prune/gideon-code references at the exact source revision, verify their commit IDs, publish only under implementation authorization and verify remote refs. Historical platform assets remain reachable there rather than being copied into the lean tree."
approval = "A new explicit user YES must reference the exact deletion-manifest digest and source revision after standalone acceptance. This plan and any extraction authorization do not authorize pruning."
rollback = "Use a separate checkout of the verified archive reference for recovery; reverse the cutover through a reviewed revert commit. Never prescribe reset --hard over a user's working tree. Preserve state schema versions and checkpoint data independently of source rollback."

[design.verification]
future_commands = "All task build_cmd/verify_cmd fields below are future contracts. New scripts and checks must be implemented in the owning task; their names are not claims that the files or gates already exist."
task_loop = "Implementation first; then at most one declared build and one verify invocation, with at most two relevant repair/rerun cycles and 30 minutes per task. Stop implemented-not-qualified with revision, command, exit code and log path on exhaustion. Split oversized tasks by spec revision before starting."
build_contract = "For Python tasks the build is a focused compile check of touched modules. Packaging tasks build the wheel once instead. No workspace test/lint/browser/sanitizer matrices at task level. Wheel acceptance consumes that single prebuilt artifact; tests must not trigger a second package build. Isolated subprocesses remove inherited PYTHONPATH and pytest project path injection."
wave_contract = "Every next wave explicitly depends on the preceding wave-close task. Wave-close commands exercise a distinct integrated consumer journey once at the merged revision; they do not repeat every task gate."
records = "Passing task evidence: spec/gideon-code/qualification/<id>.json containing revision, command, exit_code and log_path. Unrelated blockers: at most six lines per finding in qualification.kvx, including observed and assumption. Never manufacture pass evidence during planning. The qualification checks for this authored plan are syntax, graph and criterion coverage only."
real_paths = "Use real filesystem, subprocess, Git, session store, permission and provider-adapter paths. Recorded protocol bytes may test serialization but are not model capability evidence. ScriptedProvider is explicitly a fake in existing tests and cannot qualify the agent."
external = "Real-model gates require an already configured authorized endpoint/model. Missing credentials, unavailable endpoint or unsupported OS sandbox is blocked/unqualified, never a skip counted as pass. Never provision a new identity implicitly."
tooling = "Before claiming an implementation task, resolve the missing Codify workflow under explicit implementation scope. Inspect cg done semantics to avoid executing an unchanged successful verify twice. No --force completion."

[design.budget]
limits = "At prune: production Python source <=15000 physical lines and <=80 modules, excluding immutable carried fixtures and checks; <=6 direct mandatory runtime dependencies. Optional provider/MCP/parser extras are counted separately with consumer and import-isolation evidence. These are proposed acceptance limits, not measured current core size."
counting = "Inventory records counting script, include/exclude rules, source bytes, wheel bytes, mandatory and transitive dependency totals. No claimed reduction percentage without a frozen baseline."
growth = "A wave exceeding source budget or adding a dependency must revise this design with its named consumer and cost before implementation; no unused framework, server or scheduler enters the core."

[req.freeze]
title = "Preserve only relevant source behavior before extraction"
acceptance = "An exhaustive classification and immutable provenance manifest make extraction and later removal reviewable."
ac_1 = "Inventory every tracked path with disposition, reason, consumer, direct and lazy dependency edges, source revision and unresolved status; report production source and packaging baseline with reproducible counting rules."
ac_2 = "Preserve relevant source tests/fixtures byte-identically with SHA256 hashes; adapters outside the immutable corpus target the new namespace. Classify mock-dependent tests and excluded platform contracts explicitly instead of claiming them as real acceptance."
ac_3 = "Baseline archive references protect the source; no extraction task starts until classification and carried-vector manifests are accepted. No network writes occur during planning."

story = "As the user of a focused local coding agent, I require preserve only relevant source behavior before extraction with explicit failure and recovery evidence."
ac_4 = "SHALL assign every selected module a source SHA256, original licence/attribution, named retained consumer, direct/lazy/package-initializer edges and explicit ownership adapter; no retain decision follows from filename alone."
ac_5 = "SHALL preserve the original vector corpus read-only and place namespace/service adapters outside it; a missing assertion, altered inline payload or legacy-only execution SHALL fail extraction acceptance."
ac_6 = "SHALL freeze a dirty-tree fingerprint separately from HEAD, inventory untracked files without publishing their contents, and refuse destructive cutover when unrelated user changes overlap manifest paths."
ac_7 = "SHALL distinguish observed source facts, proposed decisions, unresolved interfaces and UNRUN acceptance; source size, fixture coverage and dependency counts SHALL use recorded counting rules."

[req.local]
title = "Run real model turns without the platform"
acceptance = "The independently installed CLI starts and completes a model turn without the old checkout or gateway."
ac_1 = "A clean environment installs the lean package without setup.py platform hooks, Rust, Node, gateway, daemon, old gideon imports or platform configuration; missing credentials produce an actionable nonzero exit."
ac_2 = "Anthropic and OpenAI-compatible adapters preserve tool-call IDs, streaming completion, cancellation and usage with unknown distinguished from zero; one available real provider qualifies the initial journey and each additional adapter has explicit qualification status."
ac_3 = "Text output keeps diagnostics on stderr; JSONL has ordered versioned start/delta/tool/result/end events. Exit codes: 0 completed, 1 runtime/provider failure, 2 invalid invocation/configuration, 3 permission refusal, 4 budget exhaustion, 130 interrupted."

story = "As the user of a focused local coding agent, I require run real model turns without the platform with explicit failure and recovery evidence."
ac_4 = "SHALL resolve the exact provider, endpoint, model, context window, authentication reference and capability profile before the first request; unsupported required capabilities fail configuration validation without sending a request."
ac_5 = "SHALL record a model-call identity before sending, preserve provider request/response correlation and close exactly one local call outcome; transport failure after unknown delivery SHALL not replay an effect-bearing turn blindly."
ac_6 = "SHALL parse streamed tool calls incrementally but admit execution only after a complete valid invocation with unique call ID, known tool and schema-valid bounded arguments; malformed or duplicate calls SHALL produce explicit pairing-safe errors."
ac_7 = "SHALL apply versioned turn, request, retry, token, output and elapsed-time budgets; exact-model limits outrank static estimates, missing prices remain unknown and budget exhaustion records its cause."
ac_8 = "SHALL drain or close owned streams on cancellation, terminate owned subprocess groups where present and persist terminal state before final CLI completion; a broken stdout pipe SHALL never cause duplicate tool effects."
ac_9 = "SHALL keep text, structured events and terminal UI as projections of one runtime event contract; event delivery MAY be retried by identity but a final answer SHALL be rendered once per turn."

[req.session]
title = "Resume a durable coding conversation"
acceptance = "State survives restart without importing gateway authentication or personal memory."
ac_1 = "Append-only versioned session records retain original messages, tool IDs/results, usage and cwd identity; restart restores order without duplicate effects. Reject malformed middle records and quarantine an incomplete trailing record with explicit reporting."
ac_2 = "Sessions are project-scoped and user-private; concurrent writers are rejected or serialised. Resume in a different project requires explicit confirmation. Logs redact credentials and bound tool output while retaining retrievable full-result references."

story = "As the user of a focused local coding agent, I require resume a durable coding conversation with explicit failure and recovery evidence."
ac_3 = "SHALL allocate one contiguous event sequence under an exclusive writer lease/lock, append and flush each acknowledged authority event before exposing its committed sequence, and reject unsupported schema versions without rewriting originals."
ac_4 = "SHALL reconcile effect intents without terminal receipts on restart: read-only calls may be rerun with new identities; commands and mutations remain outcome_unknown until observed or explicitly abandoned; no exactly-once side-effect promise is made."
ac_5 = "SHALL store raw-result objects before journal references become committed, verify their digest on retrieval and prohibit GC of objects referenced by sessions, checkpoints or unresolved effects."
ac_6 = "SHALL detect PID reuse/stale locks using process identity and boot identity where available; lock cleanup SHALL not create competing writers or treat a stale manifest projection as authoritative."
ac_7 = "SHALL treat symlinked state directories, permissions broader than policy, disk-full append failures and invalid hashes as explicit failure conditions; persistence failure before an effect SHALL prevent that effect."
ac_8 = "SHALL distinguish conversation identity, project identity, linked-worktree identity and source fingerprint; resuming model context SHALL not assert that background OS processes survived restart."

[req.explore]
title = "Explore a repository precisely"
acceptance = "The model answers repository questions using observable real tools."
ac_1 = "Expose bounded line-ranged read, glob, grep and existing CodeGraph outline/definition/reference capabilities; preserve ignored-file policy, binary/large-file handling, output truncation notices and raw-result retrieval."
ac_2 = "Project instructions apply root-to-leaf to affected paths with explicit provenance and budgets; nested files cannot grant permissions or cause out-of-root reads. Compaction retains task intent, instructions, unresolved work and valid tool-call pairing, with original events retrievable."
ac_3 = "A frozen Python/TypeScript/Rust fixture set contains at least 10 labelled questions per language; real-provider exploration identifies correct file and symbol on >=90% within five tool calls per question. Record model/version, prompts and failures; unsupported grammars are reported."

story = "As the user of a focused local coding agent, I require explore a repository precisely with explicit failure and recovery evidence."
ac_4 = "SHALL express line numbers as one-based inclusive bounds and return actual selected bounds, full-content digest, encoding status, truncation and raw-result reference; full-file observation SHALL not be inferred from truncated display."
ac_5 = "SHALL bound traversal depth/results/bytes, honour ignore semantics and report inaccessible or skipped paths; binary, malformed UTF-8, symlink cycles and enormous single lines SHALL not produce silent empty success."
ac_6 = "SHALL key symbol indexes by project root identity, source/config/parser version and overlay fingerprint; stale or unsupported graphs SHALL be labelled and cannot prove references are complete."
ac_7 = "SHALL preserve deterministic ordering for equal search matches and paginate with a cursor bound to query/source identity; changed inputs invalidate the cursor instead of silently dropping matches."
ac_8 = "SHALL treat repository instructions, README text, tool output and retrieved objects as untrusted content; instruction specificity MAY constrain workflow but cannot extend permission, credential or network authority."
ac_9 = "SHALL budget mandatory instructions and active task constraints before optional repo-map/history material, report omitted context, preserve original source and retain valid provider tool/result pairing under compaction."

[req.safety]
title = "One permission boundary for every effect"
acceptance = "Read-only, ask and explicitly unrestricted modes enforce the same policy across all execution paths."
ac_1 = "Policy evaluates canonical paths, symlinks, command execution, network and sensitive files before effects. Read-only mode refuses arbitrary shell execution; lexical shell screening alone never proves read-only safety."
ac_2 = "All mutating tools and bash receive the same policy and OS confinement. Missing backend fails closed for required confinement; any reduced-isolation mode requires explicit choice and is visible in events. Persisted rules are scoped and revocable."
ac_3 = "Denied operations leave files and Git state unchanged. Command output cannot grant permissions. Cancellation terminates owned process groups and releases locks; preexisting unrelated processes are unaffected."

story = "As the user of a focused local coding agent, I require one permission boundary for every effect with explicit failure and recovery evidence."
ac_4 = "SHALL evaluate explicit denies before allows and default policy; an approval binds operation identity, normalized arguments, path identities, source preimages, policy revision and bounded expiry, never just a command display string."
ac_5 = "SHALL revalidate mutable paths and preimages at the effect boundary; symlink substitution, parent replacement or changed policy between approval and execution SHALL invalidate authorization."
ac_6 = "SHALL deny by default sensitive credential/state roots and writes outside the approved project; explicit policy exceptions require human-origin configuration and SHALL remain visible in receipts."
ac_7 = "SHALL distinguish process isolation, filesystem write confinement, read confidentiality and network denial. A backend that cannot enforce a requested dimension SHALL refuse or require an explicit visible reduced-isolation choice; worktrees are not security sandboxes."
ac_8 = "SHALL apply the same permissions to child agents, MCP tool invocation, hooks, direct file tools and shell commands. Tool descriptions and remote annotations SHALL never establish trust or lower risk."
ac_9 = "SHALL log decisions without secret values, reject model-origin approval answers, cancel unanswered approvals at turn termination and refuse headless prompts without an explicit preconfigured policy."
ac_10 = "SHALL refuse permanent project policy edits from repository-provided instructions and avoid making unrestricted mode persistent by default; revocation SHALL affect newly admitted effects and cancel pending grants."

[req.edit]
title = "Edit with evidence and recover safely"
acceptance = "Coding mutations preserve user changes and expose honest transaction state."
ac_1 = "Preserve exact-once edits and pre-edit observed-content hashes; reject stale or ambiguous targets. apply_patch supports create/update/delete with bounded paths and explicit preimages, without silently matching another location."
ac_2 = "Multi-file application stages all results before commit; on failure restore only task-owned changes using a journal. Inject failures before/during commit and on restart; report recovery-required if full restoration cannot be established. Never claim filesystem-wide atomicity."
ac_3 = "Checkpoint and rewind restore the agent's own turn while preserving preexisting tracked/untracked changes; external edits cause conflict refusal, not overwrite. CLI exposes the actual diff and checkpoint identifier."

story = "As the user of a focused local coding agent, I require edit with evidence and recover safely with explicit failure and recovery evidence."
ac_4 = "SHALL preserve original byte order, newline conventions, file modes and final-newline presence except where the requested edit changes them; binary edits and unsupported encodings SHALL fail with explicit reasons."
ac_5 = "SHALL reject multiple matches, missing matches and stale read evidence before checkpoint or mutation; creating a file SHALL require an expected-absent precondition and refuse overwrite races."
ac_6 = "SHALL stage files on the destination filesystem, validate every patch hunk and manifest entry, persist rollback bytes and effect intent before the first rename, and fsync according to the stated durability boundary."
ac_7 = "SHALL expose the distinction between staged, committing, committed, rolling_back and recovery_required; readers may observe intermediate multi-file state unless they participate in the journal lock protocol."
ac_8 = "SHALL restore only paths whose current postimage matches the recorded agent result; preserve later external changes and report exact conflict paths instead of force-overwriting them."
ac_9 = "SHALL exclude secret bytes from ordinary checkpoint content and refuse a requested mutation when safe recovery cannot satisfy policy; a swallowed checkpoint error SHALL never authorise a write."
ac_10 = "SHALL retain immutable transaction/preimage/postimage hashes and a previewable actual diff, including creates/deletes/mode changes, with no absolute private-state leakage in user-facing patches."

[req.exec]
title = "Execute and report verification evidence"
acceptance = "A coding turn runs real checks and distinguishes its result from a model claim."
ac_1 = "Execution has explicit cwd/env, bounded output, timeout, exit/signal status, process ownership, cancellation and resumable background handles; shell state persistence is explicit rather than implied."
ac_2 = "For a user-requested repair, capture the permitted baseline command before editing, then run the specified verification after editing. Attribute unchanged baseline failures only when evidence supports it; otherwise label unknown. Stop after two repair cycles."
ac_3 = "Final results include actual command, revision/tree identity, exit code and log path; unrun checks are unverified. Git status/diff uses real Git and preserves unrelated user work. No automatic commit, push or merge without task authorization."

story = "As the user of a focused local coding agent, I require execute and report verification evidence with explicit failure and recovery evidence."
ac_4 = "SHALL accept either explicit argv or explicitly named shell mode, record the mode and effective cwd, and avoid silently concatenating untrusted data into shell text."
ac_5 = "SHALL distinguish spawn failure, process exit, signal, timeout, cancellation, lost ownership and unknown outcome; a timeout observation alone SHALL not assert that all descendants terminated."
ac_6 = "SHALL spool full stdout/stderr within declared disk limits, return bounded display with offsets, and report gaps or truncation explicitly; result retrieval SHALL not reread mutable project files as historical output."
ac_7 = "SHALL bind verification receipts to actual source fingerprint before/after the command, environment/toolchain profile and full log digest; tests modifying the tree invalidate a claim about an untouched revision unless recorded."
ac_8 = "SHALL distinguish baseline failure, introduced failure, unchanged failure, flaky/indeterminate and environmental block with evidence; changed configuration or different commands SHALL not be called equivalent baselines."
ac_9 = "SHALL keep repair-cycle count durable across resume, prohibit retry-budget reset by spawning a child, and report implemented-not-qualified when verification has not passed."
ac_10 = "SHALL separate command termination from shell session continuity; process handles include session, execution, boot and process identity and cannot be adopted from a bare PID."

[req.interactive]
title = "A usable local interactive coding surface"
acceptance = "Interactive and headless modes share runtime, state and policy."
ac_1 = "Interactive mode streams output, displays tool progress and approvals, accepts cancellation and supports /model /plan /diff /rewind /compact /resume with truthful context and usage status. Plan mode cannot mutate."
ac_2 = "Terminal resize and non-TTY output preserve readable results; approval input is never accepted from model output. PTY journeys use the real installed entrypoint."

story = "As the user of a focused local coding agent, I require a usable local interactive coding surface with explicit failure and recovery evidence."
ac_3 = "SHALL preserve one foreground turn per session; steering is recorded with identity and applied at a declared safe boundary, while cancellation remains available during a stream or approval."
ac_4 = "SHALL present user-origin approval prompts with operation details and consequences before acceptance; resize/repaint SHALL not submit a default choice or replay input."
ac_5 = "SHALL sanitize control sequences from model/tool output before rendering; logs retain bounded original bytes under the result-store policy, while display cannot forge UI approval controls."
ac_6 = "SHALL make /plan a permission restriction for the whole turn and its children rather than a prompt suggestion; /model changes only at a quiescent boundary with compatibility checks."
ac_7 = "SHALL disclose current model, effective permission/isolation mode, source/session identity, context estimates and usage unknowns without claiming precise cost where pricing is absent."

[req.extensions]
title = "Bounded coding subagents and optional extensions"
acceptance = "Parallel work and extension tools inherit the parent security and evidence contracts."
ac_1 = "Every child receives exact paths, one verify command, build limit, repair limit, 30-minute cap and stop condition. Writers use distinct real Git worktrees; child permissions cannot exceed the parent. Cancellation and usage roll up."
ac_2 = "Only the orchestrator integrates child changes after checking source identity and conflicts. Consume successful child receipts without rerunning unchanged child gates; run one distinct merged-wave integration journey."
ac_3 = "Optional MCP stdio client and local .agents/skills discovery are CLI-consumed, budgeted and permission-gated. Core starts without these extras; hooks are disabled by default and use the same command gate. No marketplace or production MCP server is required; a real local stdio peer may serve acceptance tests."

story = "As the user of a focused local coding agent, I require bounded coding subagents and optional extensions with explicit failure and recovery evidence."
ac_4 = "SHALL bind each child packet to parent/session/task identity, exact base commit/worktree, allowed paths, policy digest, instruction revision, required gate and remaining budget; unsupported packet fields fail before spawn."
ac_5 = "SHALL separate child process lifecycle from result custody: submitting a result freezes source identity; expiration or retry cannot silently replace an accepted immutable submission."
ac_6 = "SHALL validate child receipts against their actual base/result trees, command and source scope; model prose, task done status or a branch name alone SHALL not authorise integration."
ac_7 = "SHALL merge through a parent-owned temporary candidate after conflict checks, preserve unrelated root work and reject path drift; an integration failure SHALL retain original child artifacts for recovery."
ac_8 = "SHALL treat MCP schemas/descriptions/results as untrusted, bound schema discovery/tool count/output/runtime, require explicit executable configuration and quarantine changed server identity pending policy."
ac_9 = "SHALL resolve local skills inside approved roots without executing them on discovery; skill activation adds text to context but cannot create capabilities, change credentials or enable a hook."
ac_10 = "SHALL aggregate child usage by unique call identity without double counting parent rollups, expose incomplete child accounting and propagate cancel/stop without destroying recoverable result artifacts."

[req.prune]
title = "Remove platform code only after standalone proof"
acceptance = "An approved exact-path cutover leaves a functional independent coding package and recoverable history."
ac_1 = "Before requesting deletion approval, provide a digest-bound exact tracked-path manifest, zero old-package import reachability including lazy/optional paths, preserved license/attribution, new CI/packaging consumers and verified archive references. Unknown/shared paths block cutover."
ac_2 = "An isolated wheel install completes real read/edit/check/resume/rewind journeys with the original tree absent, not merely absent from PYTHONPATH; audit install hooks and wheel contents. Applicable carried vectors pass at this extraction revision."
ac_3 = "After explicit manifest-specific approval, apply only listed deletions and promotions in one reviewable cutover commit. Rebuild the final-layout wheel and run one post-prune consumer smoke; report budgets and archive recovery instructions. Preserve personal state and unrelated working-tree changes."

story = "As the user of a focused local coding agent, I require remove platform code only after standalone proof with explicit failure and recovery evidence."
ac_4 = "SHALL hash a canonical UTF-8 manifest containing source/tree identity, exact path operations and byte/mode hashes, promotions, retained legal/fixture files and expected final packaging/CI references; unordered or duplicate entries SHALL be rejected."
ac_5 = "SHALL reject approval when manifest bytes, source revision, dirty-tree fingerprint, archive refs or boundary evidence changes; generic historical consent is insufficient."
ac_6 = "SHALL perform final preflight before the first deletion: exact source, approved manifest, clean overlapping paths, valid archive remote refs, tested independent wheel, preserved state and no unknown classification."
ac_7 = "SHALL durably record cutover intent and per-path progress; restart after interruption SHALL identify applied operations and restore or finish only after verifying current bytes, never rerun a blind recursive deletion."
ac_8 = "SHALL promote pyproject/package/checks/scripts/CI references together under the exact manifest and re-evaluate post-prune wheel contents; deleting root setup.py is not implicit authorisation to lose licence or authorship."
ac_9 = "SHALL preserve user home state and unrelated untracked files, verify archive recovery in an isolated checkout, and use a reviewed revert for source rollback while retaining newer session data."
ac_10 = "SHALL report source, module, wheel and dependency budgets using both baseline and final manifests; unexplained growth, stale imports or inaccessible retained vectors blocks cutover closure."

[req.eval]
title = "Measure coding capability without inflated claims"
acceptance = "Reproducible issue-to-diff evaluation uses the installed CLI and independent real checks."
ac_1 = "Version at least 20 internal repair tasks with frozen source revisions, issue-only inputs, independent FAIL_TO_PASS/PASS_TO_PASS commands and no answer patches exposed to the agent; separate development and held-out tasks. Preserve harness ownership separately from agent-writable worktrees."
ac_2 = "Run tasks in disposable constrained workspaces with real provider calls and process execution; report resolved fraction, check execution rate, turns/tokens/cost where known, failure categories and environmental blocks. Never substitute scripted outcomes or silently exclude failures."
ac_3 = "Release requires all mandatory safety/recovery fixtures passing, >=90% exploration bar, zero silent wrong-target edits, and >=95% of non-environment-blocked repair runs executing verification. Report held-out solve rate without inventing a target unsupported by baseline. README and doctor expose supported providers/platforms and honest unqualified paths."

story = "As the user of a focused local coding agent, I require measure coding capability without inflated claims with explicit failure and recovery evidence."
ac_4 = "SHALL give each case stable ID, source revision, issue-only prompt, allowed agent scope, harness-owned verification commands, resource limits and immutable expected-check identifiers; holdout expected outputs remain inaccessible to the agent."
ac_5 = "SHALL verify initial FAIL_TO_PASS failure and PASS_TO_PASS success before admitting a repair case; invalid/flaky baseline cases are labelled and excluded from solve-rate denominator with visible reasons."
ac_6 = "SHALL score independently from the agent final answer and protect checker files/processes from agent writes; a modified test or forged command receipt SHALL fail the case."
ac_7 = "SHALL compute resolved, attempted, verified, blocked and invalid counts from the frozen campaign manifest, publish denominators, and retain all failures rather than removing hard tasks after a run."
ac_8 = "SHALL measure latency, model calls, tool calls, context reduction, known/unknown tokens and cost, cancellation outcome and source/output bytes, with provider/model/environment identities and no secret-bearing raw request publication."
ac_9 = "SHALL invalidate evidence when relevant source, command, fixture, model configuration or policy changes; retain old receipts as historical and never rewrite their revision to current."
ac_10 = "SHALL make release closure a read of complete current receipts and declared limitations; authoring validation, syntax, compilation and unit protocol vectors SHALL not be counted as a real coding capability pass."

[design.carried_vectors]
candidates = ["checks/runtime/test_pre_edit_read_gate.py", "checks/runtime/test_native_workspace_access.py", "checks/runtime/test_native_concurrent_dispatch.py", "checks/runtime/test_turn_checkpoints.py", "checks/runtime/test_context_compaction.py", "checks/runtime/test_provider_stream_cutoff.py", "checks/runtime/test_prompt_cache_wire_translation.py", "checks/runtime/test_codegraph.py", "checks/runtime/test_code_agentic_tools.py"]
selection = "Freeze extracts relevant fixture bytes and assertions with original file/revision/hash provenance; never copy the full platform test dependency closure blindly. Tests using mocks remain historical contract material, not standalone proof."
conflicts = "test_code_agentic_tools.py asserts some dedicated tools are absent. Preserve the original vectors, and record any deliberate new-tool contract change separately; do not edit a frozen test to make it green. Dashboard session-restore tests are not proof of the new session store. Hypermid golden vectors are archived unless their algorithm is actually ported."

[req.parallel]
title = "Parallel vertical delivery without silent semantic drift"
story = "As the owner, I need many bounded workers to deliver coherent end-to-end chunks without shared-file contention or incompatible contract meanings."
acceptance = "Explicit ownership, contract pinning, executable counterexamples and integrated evidence constrain drift; no document claims to prove absence of all software defects."
ac_1 = "Every implementation packet SHALL identify exact owned files, parent journey, prerequisites, pinned source/spec/contract digests, allowed actions, produced/consumed interfaces, reachable consumer, positive/negative/recovery cases, one build and one verify command, 30-minute cap, at most two repair cycles and explicit stop condition."
ac_2 = "Eligibility SHALL require qualified dependencies at declared versions, preceding wave closure and exclusive reservation of all owned paths. Two unordered tasks with any overlapping production, test, fixture, manifest or generated path SHALL not launch concurrently."
ac_3 = "Packets SHALL deliver vertical observable behavior through the shared host and real policy/store/process/provider adapters as applicable. A data type, standalone module, registration descriptor or direct constructor test without its consumer SHALL not satisfy completion."
ac_4 = "Shared CLI/agent/manifest assembly files SHALL have one declared integration owner. Concurrent feature packets SHALL extend trusted in-package descriptor/module paths without editing shared files; unknown, duplicate, outside-package and incompatible descriptors SHALL fail before import/effect."
ac_5 = "Contract identity SHALL hash fields, units, null semantics, ordering, failures, retry/replay, authorization and resource limits as well as signatures. Both producer and consumer receipts SHALL bind that exact semantic contract digest."
ac_6 = "An agent discovering a necessary out-of-scope file or semantic contract change SHALL report a finding and stop the affected work. Only a versioned plan amendment naming affected producers, consumers, cases and invalidated receipts may expand scope or change meaning."
ac_7 = "Parent integration SHALL consume successful packet exit/log/source receipts without rerunning an unchanged successful gate, creating a duplicate reviewer or rebuilding for confidence. One distinct cross-boundary journey SHALL run at the merged wave candidate."
ac_8 = "No task or campaign shard SHALL exceed the task cap by hiding a large test matrix inside one command. Repair/exploration/safety campaign shards SHALL freeze disjoint case sets and required variant identities; aggregation SHALL reject omissions, overlap, stale inputs and changed denominators."
ac_9 = "Every criterion SHALL map to an owning packet or explicitly identified integrated case and current source-bound evidence; static structural validation SHALL reject missing references, cycles, ownership collisions and uncovered clauses before dispatch."
ac_10 = "The approved task packet and effective permissions SHALL remain durable across disconnect/retry. A replacement agent SHALL receive the same input identity, existing artifacts and remaining repair/time budget; it SHALL not restart a fresh budget or accept stale competing results."

[design.parallel_packets]
entrypoint = "parallel-execution.md defines dispatch, locks, publication and receipt rules. Parent macro IDs remain closure/journey identities; each parent requires every child packet below before its own distinct journey."
host = "local-host-bootstrap fixes GC.Host/1 and trusted in-package descriptor loading. Every later production packet adds its own descriptor and real inspect consumer without editing cli.py or agent.py. Descriptor component_id is exactly its packet ID; no alias is implied. Inspect executes real behavior through the same policy, persistence and adapter path as default runtime; it never grants extra permissions."
contracts = "Named v1 packet input/output shapes refine the chapter contracts, not competing schemas. Resolve any field/status mismatch with runtime-contract.md, storage-context.md, tools-security.md, delegation-extensions.md, extraction-cutover.md and verification-evaluation.md by explicit spec revision before implementation."
gate_scope = "One focused build and one verify command per packet with at most two relevant repair cycles and 30 minutes. No aggregate/browser/cluster/lint campaign at packet level. Exactly one real-provider journey per macro integration and one distinct merged journey per wave; successful packet gates are never rerun by the parent."
path_scope = "Every touches entry is one exact file. Generated corpus source bytes, approved cutover operations and source fixtures require pre-start exact-file scope addenda; absent addendum blocks the packet, never authorizes a wildcard."
capability_proof = "Inspect path proves real feature behavior. Parser recordings prove protocol only. Inspect/unit/compile passes do not certify model capability, complete repair or isolated distribution. Macro/wave journeys separately use authorized real providers and independent checks."

[tasks]
heading = "Pending implementation tasks; no task is started by spec authoring"

[task.freeze-tracked]
title = "Run real Git plumbing with NUL-delimited paths and preserve non-ASCII and newline-bearing names without shell interpolation."
parent_task = "freeze-inventory"
status = "in_progress"
wave = 0
owner_lane = "inventory-tracked"
requires = []
reqs = ["freeze.1", "freeze.4", "freeze.6", "parallel.1", "parallel.2", "parallel.3", "parallel.5", "parallel.6", "parallel.7", "parallel.10"]
touches = ["lean/scripts/inventory_tracked.py", "lean/checks/packets/test_freeze_tracked.py"]
contract_inputs = "SourceSnapshot/v1: exact HEAD, index bytes fingerprint and dirty-path byte/mode fingerprints; explicit source root"
contract_outputs = "TrackedInventory/v1: every tracked path, disposition initially unresolved, bytes, mode, source revision and consumer fields"
contract_families = ["GC.Host/1", "GC.Evidence/1", "GC.Inventory/1"]
contract_digest = "Dispatch binds canonical SHA256 of versioned fields, units, null meanings, ordering, failures, retries/replay, authorization and limits; producers and consumers must match"
pinned_source = "Dispatch SHALL replace UNRESOLVED with exact qualified dependency result commit and dirty overlay digest before starting; immutable original packet retained"
pinned_spec = "Dispatch SHALL bind SHA256 of spec.kvx, this packet, referenced chapters and all semantic contract schemas before starting"
allowed_actions = "Read declared dependencies; modify only exact touches; execute one declared build and verify against disposable real fixtures under inherited policy; publication only within separate implementation authorization"
consumer_path = "lean/scripts/inventory_tracked.py"
consumer_journey = "python3 lean/scripts/inventory_tracked.py --help; execute the actual command specified in do_N against a disposable real repository. A real repository with tracked, staged, dirty and untracked paths produces exact separate identities and complete tracked coverage."
do_1 = "Run real Git plumbing with NUL-delimited paths and preserve non-ASCII and newline-bearing names without shell interpolation."
do_2 = "Expose python3 lean/scripts/inventory_tracked.py --root PATH --output PATH as the consuming command and reject an output inside source candidate files."
do_3 = "Collect untracked path names and types without reading or publishing their contents; bind dirty state separately from HEAD."
do_4 = "Refuse a completed classification receipt while any path lacks disposition, reason, legal provenance or named consumer."
positive_case = "A real repository with tracked, staged, dirty and untracked paths produces exact separate identities and complete tracked coverage."
negative_case = "An unknown disposition, non-repository root or duplicate normalized path fails nonzero without changing the source."
recovery_case = "An interrupted output is written through a temporary file and renamed only after its canonical digest is complete."
build_cmd = "python3 -m compileall -q lean/scripts/inventory_tracked.py lean/checks/packets/test_freeze_tracked.py"
verify_cmd = "PYTHONPATH=lean/src python3 -m pytest -q -o addopts= lean/checks/packets/test_freeze_tracked.py"
max_minutes = 30
max_repair_cycles = 2
stop_condition = "Stop when the exact packet behavior and its one gate qualify, publish the authorized packet and return its receipt; do not extend into parent integration. Stop implemented-not-qualified on 30 minutes, second failed repair, contract conflict, missing real external capability or scope drift; preserve command, actual exit and full log path."
evidence = "revision, command, exit_code, log_path; no claimed gate that did not run"
packet_kind = "vertical"
consumer = "python3 lean/scripts/inventory_tracked.py --help; execute the actual command specified in do_N against a disposable real repository. A real repository with tracked, staged, dirty and untracked paths produces exact separate identities and complete tracked coverage."

