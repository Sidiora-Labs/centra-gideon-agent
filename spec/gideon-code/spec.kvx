[task.doctor-release]
title = "Measure the real CLI and document supported operation"
status = "pending"
wave = 8
owner_lane = "release"
requires = ["eval-corpus", "release-doctor-consumer", "release-campaign-plan", "release-repair-shard-1", "release-repair-shard-2", "release-repair-shard-3", "release-repair-shard-4", "release-explore-python", "release-explore-typescript", "release-explore-rust", "release-safety-shard"]
reqs = ["eval.2", "eval.3", "explore.3", "parallel.8", "parallel.9"]
touches = ["src/gideon_code/cli.py", "README.md", "pyproject.toml", "spec/gideon-code/release-readiness.kvx"]
acceptance = "Bounded campaign packets execute the frozen real-provider repair/exploration/safety cases; this integration aggregates immutable complete shard receipts without rerunning them. Doctor and README expose supported profiles and unqualified cases."
build_cmd = "python3 -m compileall -q src/gideon_code/cli.py"
verify_cmd = "python3 scripts/code_eval.py --aggregate release --require-complete-receipts"
max_minutes = 30
max_repair_cycles = 2
packet_kind = "integration"
contract_inputs = ["GC.Host/1", "GC.Evidence/1"]
contract_outputs = ["GC.Evidence/1"]
stop_condition = "Stop on full declared implementation and one passing focused gate; otherwise stop at 30 minutes or after two relevant repair cycles with implemented-not-qualified evidence. Never extend scope or weaken criteria."
evidence = "spec/gideon-code/qualification/doctor-release.json; revision, command, exit_code, log_path and referenced input hashes; UNRUN until execution."
do_1 = "Compose doctor capability observations and the frozen real-provider campaign driver with exact installed artifact, provider/model/policy/source and toolchain identities."
do_2 = "Consume the declared bounded release campaign shard receipts once: all issue repair outcomes, labelled exploration, required safety/recovery cases and explicit platform/provider matrix. Reject missing/overlapping/stale shard identities without re-executing their successful checks."
do_3 = "Publish all denominators, failures, environmental blocks, costs/usage unknowns, turns and tool calls. No skipped safety gate, scripted response or rewritten source identity may become passing evidence."
do_4 = "Update user documentation only from current receipts and actual supported behavior. Report held-out solve rate honestly; structural pack validation and the number of tasks do not prove capability."
do_5 = "Consume packet-owned implementation as immutable qualified input. Edit only the exact shared composition files and this task integrated check; changing packet semantics requires an explicit contract/scope amendment and invalidates only affected evidence."

