[task.integrate]
title = "Integrate all product slices and applicable hosted counterparts into local main"
status = "pending"
wave = 2
owner_lane = "root"
requires = ["runtime-memory", "runtime-models", "runtime-sessions", "runtime-experiments", "experience-workspace", "experience-onboarding", "experience-creative", "experience-polish", "automation-workflows", "automation-proactivity", "automation-tasks", "automation-apps", "integrations-protocols", "integrations-channels", "integrations-terminal", "integrations-distribution"]

[design.runtime]
imports = "Normalize supported exported conversations into existing session/history stores with source chronology, preview selection and resumable identity; archive recall returns original stored text and origin references within caller budgets."
memory = "Ordered session extraction drains independently of interactive turns; delegated contributions retain run identity; aliases, typed edges and deletion tombstones persist in canonical knowledge stores."
model_loop = "Read served context limits once through the common resolver; recovery does not replay completed tools; cache and usage fields survive child and workflow accounting; configuration replacement occurs between turns."
experiments = "Campaigns, machine resources, replay and offline candidates have persisted identifiers, reachable operator interfaces, actual execution or recorded trajectories and inspectable results. Hosted exposes only managed campaigns and replay."

[design.experience]
workspace = "Session-scoped panel layout persists; live workflow cards retain run/node identity; deliverables resolve canonical artifact versions; delegated controls address stable run IDs."
conversation = "Storage restores the complete transcript while prompt assembly remains bounded. Stream recovery reconciles authoritative terminal state without stealing a newer send or duplicating final text."
onboarding = "URLs and saved progress identify the current step. Local model setup is OSS-only. Hosted retains existing managed bindings and only exposes customer-owned preferences."
creative = "Presentation, design and research journeys consume actual input, produce canonical artifacts and expose editing/rendering/results; voice and file flows extend current working providers and viewers."

[design.automation]
workflows = "Use existing WorkflowDef, WorkflowRun and journals. Node failure attribution, binding defaults, retry ownership, output notices, declared input types, terminal states and committed effects are reflected through actual API and console consumers."
rounds = "Role rounds and planner decisions reuse existing workflows, proposals, triggers, attention and delivery contracts; persist handoff ownership and resumable state instead of adding a second execution engine."
tasks = "Task list, DAG, prerequisite and scoped progress consumers see the complete relevant set. Inbox actions and counts retain exact source IDs; trigger and notification outcomes correspond to real dispatch."
apps = "App contributions attach to existing hook, provider, widget and pack lifecycles. Installation and form outcomes are visible; staged roster activation reports actual activated agents."

[design.integrations]
protocols = "ACP server, A2A task lifecycle and MCP resources/prompts/OAuth connect to existing sessions and task execution with functional request/response and cancellation semantics."
channels = "Use existing installed adapter implementations when present; implement missing platform transports through ChannelMessage/OutboundMessage contracts. Per-channel queues isolate delivery and preserve ordered retry outcomes."
terminal = "Terminal client uses gateway session streaming, tools and approvals; hosted accepts existing authenticated identity and omits operator model setup."
distribution = "OSS single-container packaging serves runtime and console and persists workspace under the mounted data root. Hosted keeps its existing managed process architecture and storage conventions."
