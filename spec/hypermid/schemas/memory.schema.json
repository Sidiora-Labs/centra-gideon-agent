          "$ref": "common.schema.json#/$defs/Digest"
        },
        "lease_expires_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "attempt": {
          "type": "integer",
          "minimum": 1
        },
        "budget": {
          "$ref": "#/$defs/ModelBudget"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "trace": {
          "$ref": "common.schema.json#/$defs/Trace"
        }
      }
    },
