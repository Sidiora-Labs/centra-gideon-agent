    "MaintenanceJob": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "scope",
        "actor_scope",
        "state",
        "input_cursor",
        "budget",
        "attempt",
        "created_at",
        "trace"
      ],
      "properties": {
        "id": {
          "$ref": "common.schema.json#/$defs/Id"
        },
        "kind": {
          "$ref": "#/$defs/MaintenanceKind"
        },
        "scope": {
          "$ref": "common.schema.json#/$defs/Scope"
        },
        "actor_scope": {
          "$ref": "common.schema.json#/$defs/Scope"
        },
        "state": {
          "type": "string",
          "enum": [
            "queued",
            "claimed",
            "running",
            "checkpointed",
            "succeeded",
            "failed",
            "abandoned"
