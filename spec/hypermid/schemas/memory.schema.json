          "$ref": "common.schema.json#/$defs/Digest"
        },
        "target_scope": {
          "$ref": "common.schema.json#/$defs/Scope"
        },
        "item_count": {
          "type": "integer",
          "minimum": 0
        },
        "scope_mapping": {
          "type": "object",
          "additionalProperties": {
            "$ref": "common.schema.json#/$defs/Scope"
          }
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "trace": {
          "$ref": "common.schema.json#/$defs/Trace"
        }
      }
    },
    "ExportManifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
