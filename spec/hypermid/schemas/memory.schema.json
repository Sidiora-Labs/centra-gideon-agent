          "properties": {
            "unauthorized": {
              "type": "integer",
              "minimum": 0
            },
            "state": {
              "type": "integer",
              "minimum": 0
            },
            "stale": {
              "type": "integer",
              "minimum": 0
            },
            "visible": {
              "type": "integer",
              "minimum": 0
            },
            "duplicate": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "degraded": {
          "type": "boolean"
        },
        "degradation_reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "trace": {
          "$ref": "common.schema.json#/$defs/Trace"
        }
      }
