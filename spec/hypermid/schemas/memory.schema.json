          "type": "integer",
          "minimum": 0
        },
        "stream_digest": {
          "$ref": "common.schema.json#/$defs/Digest"
        },
        "include_grants": {
          "type": "boolean",
          "default": false
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "cursor": {
          "$ref": "common.schema.json#/$defs/Cursor"
        },
        "trace": {
          "$ref": "common.schema.json#/$defs/Trace"
        }
      }
    },
    "ErrorResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "error",
