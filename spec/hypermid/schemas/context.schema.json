{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hypermid.gideon.dev/schemas/context.schema.json",
  "title": "Hypermid Context Contract",
  "description": "Versioned contracts for scoped context ingestion, projection, reduction, recovery, background summaries, hooks, subagents, and diagnostics.",
  "oneOf": [
    { "$ref": "#/$defs/ProtocolRequest" },
    { "$ref": "#/$defs/ProtocolResponse" },
    { "$ref": "#/$defs/TransferChunk" },
    { "$ref": "#/$defs/SessionBinding" },
    { "$ref": "#/$defs/ContextItem" },
    { "$ref": "#/$defs/Projection" },
    { "$ref": "#/$defs/SummaryJob" },
    { "$ref": "#/$defs/SummaryRecord" },
    { "$ref": "#/$defs/ReductionRequest" },
    { "$ref": "#/$defs/ReductionResult" },
    { "$ref": "#/$defs/RecoveryRequest" },
    { "$ref": "#/$defs/RecoveryResult" },
    { "$ref": "#/$defs/PortabilityManifest" },
    { "$ref": "#/$defs/HookEvent" },
    { "$ref": "#/$defs/ContextDiagnostics" }
  ],
  "$defs": {
    "ProtocolVersion": {
      "type": "string",
      "const": "1.0"
    },
    "Operation": {
      "type": "string",
      "enum": [
        "bind",
        "rebind",
        "ingest",
        "project",
        "reduce",
        "expand",
        "summary_claim",
        "summary_publish",
        "recover",
        "configure",
        "subagent_spawn",
        "subagent_contribute",
        "export",
        "import",
        "diagnose"
      ]
    },
    "Mode": {
      "type": "string",
      "enum": ["off", "pass_through", "shadow", "primary"]
    },
    "OverflowPolicy": {
      "type": "string",
      "enum": ["reclaim_then_refuse", "refuse_immediately"]
    },
    "RefusalPolicy": {
      "type": "string",
      "enum": ["refuse", "compatible_last_known_good", "host_passthrough"]
    },
    "RenderMode": {
      "type": "string",
      "const": "host_serialized"
    },
    "Role": {
      "type": "string",
      "enum": ["system", "user", "assistant", "tool"]
    },
    "PartKind": {
      "type": "string",
      "enum": ["text", "reasoning", "tool_call", "tool_result", "image", "file", "context_marker"]
    },
    "RelationKind": {
      "type": "string",
      "enum": ["continues", "supersedes", "regenerates", "forks_from", "imports", "derived_from", "contributed_by"]
    },
    "RegionKind": {
      "type": "string",
      "enum": ["baseline", "delta", "tail"]
    },
    "PressureBand": {
      "type": "string",
      "enum": ["normal", "advisory", "action", "emergency", "hard_wall"]
    },
    "ReasonCode": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{1,63}$"
    },
    "WriterLease": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lease_id", "session_id", "scope", "fence_token", "acquired_at", "expires_at", "cursor"],
      "properties": {
        "lease_id": { "$ref": "common.schema.json#/$defs/Id" },
        "session_id": { "$ref": "common.schema.json#/$defs/Id" },
        "scope": { "$ref": "common.schema.json#/$defs/Scope" },
        "fence_token": { "$ref": "common.schema.json#/$defs/Id" },
        "acquired_at": { "type": "string", "format": "date-time" },
        "expires_at": { "type": "string", "format": "date-time" },
        "cursor": { "$ref": "common.schema.json#/$defs/Cursor" }
      }
    },
    "SessionBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["session_id", "scope", "mode", "render_mode", "overflow_policy", "refusal_policy", "policy_revision", "config_digest", "cursor"],
      "properties": {
        "session_id": { "$ref": "common.schema.json#/$defs/Id" },
        "scope": { "$ref": "common.schema.json#/$defs/Scope" },
        "mode": { "$ref": "#/$defs/Mode" },
        "render_mode": { "$ref": "#/$defs/RenderMode" },
        "overflow_policy": { "$ref": "#/$defs/OverflowPolicy" },
        "refusal_policy": { "$ref": "#/$defs/RefusalPolicy" },
        "policy_revision": { "type": "integer", "minimum": 1 },
        "config_digest": { "$ref": "common.schema.json#/$defs/Digest" },
        "cursor": { "$ref": "common.schema.json#/$defs/Cursor" },
        "writer_lease": { "$ref": "#/$defs/WriterLease" },
        "parent_session_id": { "$ref": "common.schema.json#/$defs/Id" },
        "spawn_cursor": { "$ref": "common.schema.json#/$defs/Cursor" }
      },
      "allOf": [
        {
          "if": { "properties": { "mode": { "const": "primary" } }, "required": ["mode"] },
          "then": { "required": ["writer_lease"] }
        }
      ]
    },
    "ItemRelation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "item_id"],
      "properties": {
        "kind": { "$ref": "#/$defs/RelationKind" },
        "item_id": { "$ref": "common.schema.json#/$defs/Id" },
        "source_digest": { "$ref": "common.schema.json#/$defs/Digest" }
      }
    },
    "ContextPart": {
      "type": "object",
      "additionalProperties": false,
      "required": ["part_id", "kind", "content_digest"],
      "properties": {
        "part_id": { "$ref": "common.schema.json#/$defs/Id" },
        "kind": { "$ref": "#/$defs/PartKind" },
        "content_digest": { "$ref": "common.schema.json#/$defs/Digest" },
        "text": { "type": "string", "maxLength": 1048576 },
        "call_id": { "$ref": "common.schema.json#/$defs/Id" },
        "tool_name": { "type": "string", "minLength": 1, "maxLength": 256 },
        "arguments_json": { "type": "string", "maxLength": 1048576 },
        "result_json": { "type": "string", "maxLength": 4194304 },
        "media_type": { "type": "string", "minLength": 1, "maxLength": 128 },
        "source_uri": { "type": "string", "maxLength": 4096 },
        "width": { "type": "integer", "minimum": 1, "maximum": 100000 },
        "height": { "type": "integer", "minimum": 1, "maximum": 100000 },
        "metadata": { "type": "object", "maxProperties": 32, "additionalProperties": true }
      },
      "allOf": [
        {
          "if": { "properties": { "kind": { "enum": ["text", "reasoning", "context_marker"] } }, "required": ["kind"] },
          "then": { "required": ["text"] }
        },
        {
          "if": { "properties": { "kind": { "const": "tool_call" } }, "required": ["kind"] },
          "then": { "required": ["call_id", "tool_name", "arguments_json"] }
        },
        {
          "if": { "properties": { "kind": { "const": "tool_result" } }, "required": ["kind"] },
          "then": { "required": ["call_id", "result_json"] }
        },
        {
          "if": { "properties": { "kind": { "enum": ["image", "file"] } }, "required": ["kind"] },
          "then": { "required": ["media_type", "source_uri"] }
        }
      ]
    },
    "ContextItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["item_id", "source_event_id", "source_digest", "scope", "session_id", "cursor", "role", "parts", "created_at", "recoverable"],
      "properties": {
        "item_id": { "$ref": "common.schema.json#/$defs/Id" },
        "source_event_id": { "$ref": "common.schema.json#/$defs/Id" },
        "source_digest": { "$ref": "common.schema.json#/$defs/Digest" },
        "scope": { "$ref": "common.schema.json#/$defs/Scope" },
        "session_id": { "$ref": "common.schema.json#/$defs/Id" },
        "cursor": { "$ref": "common.schema.json#/$defs/Cursor" },
        "role": { "$ref": "#/$defs/Role" },
        "parts": { "type": "array", "minItems": 1, "maxItems": 4096, "items": { "$ref": "#/$defs/ContextPart" } },
        "relations": { "type": "array", "maxItems": 64, "items": { "$ref": "#/$defs/ItemRelation" } },
        "created_at": { "type": "string", "format": "date-time" },
        "recoverable": { "type": "boolean" },
        "tombstone": { "type": "boolean", "default": false }
      }
    },
    "ProviderProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile_id", "profile_digest", "context_window_tokens", "reserved_output_tokens", "roles", "part_kinds", "requires_tool_adjacency", "supports_reasoning", "supports_cache_boundaries", "max_cache_boundaries"],
      "properties": {
        "profile_id": { "$ref": "common.schema.json#/$defs/Id" },
        "profile_digest": { "$ref": "common.schema.json#/$defs/Digest" },
        "context_window_tokens": { "type": "integer", "minimum": 1, "maximum": 1000000000 },
        "reserved_output_tokens": { "type": "integer", "minimum": 0, "maximum": 1000000000 },
        "roles": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/Role" } },
        "part_kinds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/PartKind" } },
        "requires_tool_adjacency": { "type": "boolean" },
        "supports_reasoning": { "type": "boolean" },
        "supports_cache_boundaries": { "type": "boolean" },
        "max_cache_boundaries": { "type": "integer", "minimum": 0, "maximum": 64 },
        "max_images": { "type": "integer", "minimum": 0, "maximum": 4096 },
        "image_accounting": { "type": "string", "enum": ["tokens", "tiles", "host_reported"] }
      }
    },
    "ModelBudget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["context_window_tokens", "reserved_output_tokens", "max_input_tokens", "max_items", "max_images", "baseline_tokens", "delta_tokens", "tail_tokens", "confidence"],
      "properties": {
        "context_window_tokens": { "type": "integer", "minimum": 1, "maximum": 1000000000 },
        "reserved_output_tokens": { "type": "integer", "minimum": 0, "maximum": 1000000000 },
        "max_input_tokens": { "type": "integer", "minimum": 0, "maximum": 1000000000 },
        "max_items": { "type": "integer", "minimum": 1, "maximum": 1000000 },
        "max_images": { "type": "integer", "minimum": 0, "maximum": 4096 },
        "baseline_tokens": { "type": "integer", "minimum": 0, "maximum": 1000000000 },
        "delta_tokens": { "type": "integer", "minimum": 0, "maximum": 1000000000 },
        "tail_tokens": { "type": "integer", "minimum": 0, "maximum": 1000000000 },
        "confidence": { "type": "string", "enum": ["measured", "calibrated", "conservative"] }
      }
    },
    "NormalizedBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["block_id", "role", "parts", "source_item_ids", "content_digest", "cache_boundary"],
      "properties": {
        "block_id": { "$ref": "common.schema.json#/$defs/Id" },
        "role": { "$ref": "#/$defs/Role" },
        "parts": { "type": "array", "minItems": 1, "maxItems": 4096, "items": { "$ref": "#/$defs/ContextPart" } },
        "source_item_ids": { "type": "array", "maxItems": 4096, "items": { "$ref": "common.schema.json#/$defs/Id" } },
        "content_digest": { "$ref": "common.schema.json#/$defs/Digest" },
        "cache_boundary": { "type": "string", "enum": ["none", "after"] },
        "synthetic": { "type": "boolean", "default": false }
      }
    },
    "ProjectionRegion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "digest", "item_ids", "token_mass"],
      "properties": {
        "kind": { "$ref": "#/$defs/RegionKind" },
        "digest": { "$ref": "common.schema.json#/$defs/Digest" },
        "item_ids": { "type": "array", "maxItems": 100000, "items": { "$ref": "common.schema.json#/$defs/Id" } },
        "summary_ids": { "type": "array", "maxItems": 100000, "items": { "$ref": "common.schema.json#/$defs/Id" } },
        "token_mass": { "type": "integer", "minimum": 0, "maximum": 1000000000 }
      }
    },
    "Projection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["projection_id", "scope", "session_id", "source_cursor", "source_digest", "generation", "policy_revision", "mode", "render_mode", "overflow_policy", "refusal_policy", "provider_profile_digest", "model_budget", "baseline", "delta", "tail", "blocks", "output_digest", "reason_code", "created_at"],
      "properties": {
        "projection_id": { "$ref": "common.schema.json#/$defs/Id" },
        "scope": { "$ref": "common.schema.json#/$defs/Scope" },
        "session_id": { "$ref": "common.schema.json#/$defs/Id" },
        "source_cursor": { "$ref": "common.schema.json#/$defs/Cursor" },
        "source_digest": { "$ref": "common.schema.json#/$defs/Digest" },
        "generation": { "type": "integer", "minimum": 1 },
        "policy_revision": { "type": "integer", "minimum": 1 },
        "mode": { "$ref": "#/$defs/Mode" },
        "render_mode": { "$ref": "#/$defs/RenderMode" },
        "overflow_policy": { "$ref": "#/$defs/OverflowPolicy" },
        "refusal_policy": { "$ref": "#/$defs/RefusalPolicy" },
        "provider_profile_digest": { "$ref": "common.schema.json#/$defs/Digest" },
        "model_budget": { "$ref": "#/$defs/ModelBudget" },
        "baseline": { "$ref": "#/$defs/ProjectionRegion" },
        "delta": { "$ref": "#/$defs/ProjectionRegion" },
        "tail": { "$ref": "#/$defs/ProjectionRegion" },
        "blocks": { "type": "array", "maxItems": 100000, "items": { "$ref": "#/$defs/NormalizedBlock" } },
        "output_digest": { "$ref": "common.schema.json#/$defs/Digest" },
        "serialized_digest": { "$ref": "common.schema.json#/$defs/Digest" },
        "pressure_band": { "$ref": "#/$defs/PressureBand" },
        "reason_code": { "$ref": "#/$defs/ReasonCode" },
        "created_at": { "type": "string", "format": "date-time" }
      }
    },
    "SummaryTier": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level", "content", "content_digest", "token_mass"],
      "properties": {
        "level": { "type": "integer", "minimum": 0, "maximum": 3 },
        "content": { "type": "string", "minLength": 1, "maxLength": 1048576 },
        "content_digest": { "$ref": "common.schema.json#/$defs/Digest" },
        "token_mass": { "type": "integer", "minimum": 1, "maximum": 1000000000 }
      }
    },
    "SummaryJob": {
      "type": "object",
      "additionalProperties": false,
      "required": ["job_id", "scope", "session_id", "source_start", "source_end", "source_digest", "lease_id", "lease_expires_at", "tier_levels", "locale", "max_input_tokens", "max_output_tokens", "attempt"],
      "properties": {
        "job_id": { "$ref": "common.schema.json#/$defs/Id" },
        "scope": { "$ref": "common.schema.json#/$defs/Scope" },
        "session_id": { "$ref": "common.schema.json#/$defs/Id" },
        "source_start": { "$ref": "common.schema.json#/$defs/Cursor" },
        "source_end": { "$ref": "common.schema.json#/$defs/Cursor" },
        "source_digest": { "$ref": "common.schema.json#/$defs/Digest" },
        "lease_id": { "$ref": "common.schema.json#/$defs/Id" },
        "lease_expires_at": { "type": "string", "format": "date-time" },
        "tier_levels": { "type": "array", "minItems": 4, "maxItems": 4, "uniqueItems": true, "items": { "type": "integer", "minimum": 0, "maximum": 3 } },
        "locale": { "type": "string", "minLength": 2, "maxLength": 64 },
        "max_input_tokens": { "type": "integer", "minimum": 1, "maximum": 1000000000 },
        "max_output_tokens": { "type": "integer", "minimum": 1, "maximum": 1000000000 },
        "attempt": { "type": "integer", "minimum": 1, "maximum": 100 }
      }
    },
    "SummaryRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary_id", "scope", "session_id", "source_start", "source_end", "source_digest", "tiers", "importance", "created_at"],
      "properties": {
        "summary_id": { "$ref": "common.schema.json#/$defs/Id" },
        "scope": { "$ref": "common.schema.json#/$defs/Scope" },
        "session_id": { "$ref": "common.schema.json#/$defs/Id" },
        "source_start": { "$ref": "common.schema.json#/$defs/Cursor" },
        "source_end": { "$ref": "common.schema.json#/$defs/Cursor" },
        "source_digest": { "$ref": "common.schema.json#/$defs/Digest" },
        "tiers": { "type": "array", "minItems": 4, "maxItems": 4, "items": { "$ref": "#/$defs/SummaryTier" } },
        "importance": { "type": "number", "minimum": 0, "maximum": 1 },
        "facts": { "type": "array", "maxItems": 256, "items": { "type": "string", "maxLength": 4096 } },
        "events": { "type": "array", "maxItems": 256, "items": { "type": "string", "maxLength": 4096 } },
        "created_at": { "type": "string", "format": "date-time" }
      }
    },
    "ReductionTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tag_start", "tag_end"],
      "properties": {
        "tag_start": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "tag_end": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 }
      }
    },
    "ReductionRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scope", "session_id", "expected_cursor", "idempotency_key", "targets", "trace"],
      "properties": {
        "scope": { "$ref": "common.schema.json#/$defs/Scope" },
        "session_id": { "$ref": "common.schema.json#/$defs/Id" },
        "expected_cursor": { "$ref": "common.schema.json#/$defs/Cursor" },
        "idempotency_key": { "$ref": "common.schema.json#/$defs/Id" },
        "targets": { "type": "array", "minItems": 1, "maxItems": 1024, "items": { "$ref": "#/$defs/ReductionTarget" } },
        "trace": { "$ref": "common.schema.json#/$defs/Trace" }
      }
    },
    "ReductionOutcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tag", "status", "reason_code"],
      "properties": {
        "tag": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "status": { "type": "string", "enum": ["queued", "applied", "rejected", "already_applied"] },
        "reason_code": { "$ref": "#/$defs/ReasonCode" },
        "item_id": { "$ref": "common.schema.json#/$defs/Id" },
        "estimated_tokens": { "type": "integer", "minimum": 0, "maximum": 1000000000 }
      }
    },
    "ReductionResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scope", "session_id", "cursor", "idempotency_key", "outcomes", "trace"],
      "properties": {
        "scope": { "$ref": "common.schema.json#/$defs/Scope" },
        "session_id": { "$ref": "common.schema.json#/$defs/Id" },
        "cursor": { "$ref": "common.schema.json#/$defs/Cursor" },
        "idempotency_key": { "$ref": "common.schema.json#/$defs/Id" },
        "outcomes": { "type": "array", "minItems": 1, "maxItems": 100000, "items": { "$ref": "#/$defs/ReductionOutcome" } },
        "trace": { "$ref": "common.schema.json#/$defs/Trace" }
      }
    },
    "RecoveryRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scope", "session_id", "trace"],
      "properties": {
        "scope": { "$ref": "common.schema.json#/$defs/Scope" },
        "session_id": { "$ref": "common.schema.json#/$defs/Id" },
        "item_ids": { "type": "array", "maxItems": 4096, "items": { "$ref": "common.schema.json#/$defs/Id" } },
        "tags": { "type": "array", "maxItems": 4096, "items": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 } },
        "cursor_start": { "$ref": "common.schema.json#/$defs/Cursor" },
        "cursor_end": { "$ref": "common.schema.json#/$defs/Cursor" },
        "projection_id": { "$ref": "common.schema.json#/$defs/Id" },
        "trace": { "$ref": "common.schema.json#/$defs/Trace" }
      },
      "anyOf": [
        { "required": ["item_ids"] },
        { "required": ["tags"] },
        { "required": ["cursor_start", "cursor_end"] },
        { "required": ["projection_id"] }
      ]
    },
    "RecoveredItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["item_id", "source_event_id", "source_digest", "role", "parts", "relations"],
      "properties": {
        "item_id": { "$ref": "common.schema.json#/$defs/Id" },
        "source_event_id": { "$ref": "common.schema.json#/$defs/Id" },
        "source_digest": { "$ref": "common.schema.json#/$defs/Digest" },
        "role": { "$ref": "#/$defs/Role" },
        "parts": { "type": "array", "minItems": 1, "maxItems": 4096, "items": { "$ref": "#/$defs/ContextPart" } },
        "relations": { "type": "array", "maxItems": 64, "items": { "$ref": "#/$defs/ItemRelation" } }
      }
    },
    "RecoveryResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scope", "session_id", "cursor", "items", "source_verified", "trace"],
      "properties": {
        "scope": { "$ref": "common.schema.json#/$defs/Scope" },
        "session_id": { "$ref": "common.schema.json#/$defs/Id" },
        "cursor": { "$ref": "common.schema.json#/$defs/Cursor" },
        "items": { "type": "array", "maxItems": 100000, "items": { "$ref": "#/$defs/RecoveredItem" } },
        "projection": { "$ref": "#/$defs/Projection" },
        "source_verified": { "type": "boolean" },
        "trace": { "$ref": "common.schema.json#/$defs/Trace" }
      }
    },
    "PortabilityEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entry_id", "kind", "content_digest", "byte_length"],
      "properties": {
        "entry_id": { "$ref": "common.schema.json#/$defs/Id" },
        "kind": { "type": "string", "enum": ["source_reference", "source_snapshot", "summary", "projection", "policy_revision", "cache_generation", "reduction"] },
        "content_digest": { "$ref": "common.schema.json#/$defs/Digest" },
        "byte_length": { "type": "integer", "minimum": 0, "maximum": 8388608 }
      }
    },
    "PortabilityManifest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["manifest_id", "schema_version", "scope", "session_id", "cursor", "session_binding_digest", "entries", "entries_digest", "created_at"],
      "properties": {
        "manifest_id": { "$ref": "common.schema.json#/$defs/Id" },
        "schema_version": { "type": "integer", "const": 1 },
        "scope": { "$ref": "common.schema.json#/$defs/Scope" },
        "session_id": { "$ref": "common.schema.json#/$defs/Id" },
        "cursor": { "$ref": "common.schema.json#/$defs/Cursor" },
        "session_binding_digest": { "$ref": "common.schema.json#/$defs/Digest" },
        "entries": { "type": "array", "maxItems": 1000000, "items": { "$ref": "#/$defs/PortabilityEntry" } },
        "entries_digest": { "$ref": "common.schema.json#/$defs/Digest" },
        "created_at": { "type": "string", "format": "date-time" }
      }
    },
    "ExportPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cursor", "include_source_snapshots"],
      "properties": {
        "cursor": { "$ref": "common.schema.json#/$defs/Cursor" },
        "include_source_snapshots": { "type": "boolean" }
      }
    },
    "ImportPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["manifest", "staging_id"],
      "properties": {
        "manifest": { "$ref": "#/$defs/PortabilityManifest" },
        "staging_id": { "$ref": "common.schema.json#/$defs/Id" }
      }
    },
    "SubagentSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["child_session_id", "parent_session_id", "scope", "spawn_cursor", "source_digest", "mode_ceiling", "provider_profile_digest", "model_budget", "item_ids"],
      "properties": {
        "child_session_id": { "$ref": "common.schema.json#/$defs/Id" },
        "parent_session_id": { "$ref": "common.schema.json#/$defs/Id" },
        "scope": { "$ref": "common.schema.json#/$defs/Scope" },
        "spawn_cursor": { "$ref": "common.schema.json#/$defs/Cursor" },
        "source_digest": { "$ref": "common.schema.json#/$defs/Digest" },
        "mode_ceiling": { "$ref": "#/$defs/Mode" },
        "provider_profile_digest": { "$ref": "common.schema.json#/$defs/Digest" },
        "model_budget": { "$ref": "#/$defs/ModelBudget" },
        "item_ids": { "type": "array", "maxItems": 100000, "items": { "$ref": "common.schema.json#/$defs/Id" } }
      }
    },
    "HookEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["event_id", "kind", "scope", "trace", "session_id", "cursor", "policy_revision", "phase", "metadata", "created_at"],
      "properties": {
        "event_id": { "$ref": "common.schema.json#/$defs/Id" },
        "kind": {
          "type": "string",
          "enum": ["session_bind", "ingest", "project", "pressure_change", "reduction", "summary", "recovery", "subagent_snapshot", "diagnostic_fault"]
        },
        "scope": { "$ref": "common.schema.json#/$defs/Scope" },
        "trace": { "$ref": "common.schema.json#/$defs/Trace" },
        "session_id": { "$ref": "common.schema.json#/$defs/Id" },
        "cursor": { "$ref": "common.schema.json#/$defs/Cursor" },
        "policy_revision": { "type": "integer", "minimum": 1 },
        "phase": { "type": "string", "enum": ["pre", "post"] },
        "outcome": { "type": "string", "enum": ["allow", "deny", "inject", "committed", "rejected", "timed_out", "failed"] },
        "synthetic_blocks": { "type": "array", "maxItems": 128, "items": { "$ref": "#/$defs/NormalizedBlock" } },
        "metadata": { "type": "object", "maxProperties": 64, "additionalProperties": true },
        "created_at": { "type": "string", "format": "date-time" }
      }
    },
    "UsageAccounting": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "input_tokens", "output_tokens", "cache_read_tokens", "cache_write_tokens"],
      "properties": {
        "state": { "type": "string", "enum": ["no_call", "missing", "reported_zero", "reported"] },
        "input_tokens": { "type": ["integer", "null"], "minimum": 0, "maximum": 1000000000 },
        "output_tokens": { "type": ["integer", "null"], "minimum": 0, "maximum": 1000000000 },
        "cache_read_tokens": { "type": ["integer", "null"], "minimum": 0, "maximum": 1000000000 },
        "cache_write_tokens": { "type": ["integer", "null"], "minimum": 0, "maximum": 1000000000 }
      }
    },
    "DiagnosticOutcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["at", "reason_code", "trace", "message"],
      "properties": {
        "at": { "type": "string", "format": "date-time" },
        "reason_code": { "$ref": "#/$defs/ReasonCode" },
        "trace": { "$ref": "common.schema.json#/$defs/Trace" },
        "message": { "type": "string", "maxLength": 2048 }
      }
    },
    "ContextDiagnostics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scope", "session_id", "cursor", "generation", "mode", "render_mode", "overflow_policy", "refusal_policy", "policy_revision", "provider_profile_digest", "journal_items", "journal_bytes", "model_budget", "pressure_band", "baseline", "delta", "tail", "pending_reductions", "summary_jobs", "last_known_good_eligible", "last_reason_code", "foreground_usage", "summary_usage", "subagent_usage", "recent_outcomes", "generated_at"],
      "properties": {
        "scope": { "$ref": "common.schema.json#/$defs/Scope" },
        "session_id": { "$ref": "common.schema.json#/$defs/Id" },
        "cursor": { "$ref": "common.schema.json#/$defs/Cursor" },
        "generation": { "type": "integer", "minimum": 1 },
        "mode": { "$ref": "#/$defs/Mode" },
        "render_mode": { "$ref": "#/$defs/RenderMode" },
        "overflow_policy": { "$ref": "#/$defs/OverflowPolicy" },
        "refusal_policy": { "$ref": "#/$defs/RefusalPolicy" },
        "policy_revision": { "type": "integer", "minimum": 1 },
        "provider_profile_digest": { "$ref": "common.schema.json#/$defs/Digest" },
        "journal_items": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "journal_bytes": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "model_budget": { "$ref": "#/$defs/ModelBudget" },
        "pressure_band": { "$ref": "#/$defs/PressureBand" },
        "baseline": { "$ref": "#/$defs/ProjectionRegion" },
        "delta": { "$ref": "#/$defs/ProjectionRegion" },
        "tail": { "$ref": "#/$defs/ProjectionRegion" },
        "protected_item_ids": { "type": "array", "maxItems": 100000, "items": { "$ref": "common.schema.json#/$defs/Id" } },
        "selected_tiers": { "type": "object", "maxProperties": 100000, "additionalProperties": { "type": "integer", "minimum": 0, "maximum": 3 } },
        "pending_reductions": { "type": "integer", "minimum": 0, "maximum": 1000000 },
        "summary_jobs": { "type": "integer", "minimum": 0, "maximum": 1000000 },
        "writer_lease": { "$ref": "#/$defs/WriterLease" },
        "last_known_good_eligible": { "type": "boolean" },
        "last_reason_code": { "$ref": "#/$defs/ReasonCode" },
        "foreground_usage": { "$ref": "#/$defs/UsageAccounting" },
        "summary_usage": { "$ref": "#/$defs/UsageAccounting" },
        "subagent_usage": { "$ref": "#/$defs/UsageAccounting" },
        "recent_outcomes": { "type": "array", "maxItems": 256, "items": { "$ref": "#/$defs/DiagnosticOutcome" } },
        "generated_at": { "type": "string", "format": "date-time" }
      }
    },
    "TransferChunk": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol_version", "transfer_id", "ordinal", "total", "chunk_digest", "full_digest", "payload_base64", "trace"],
      "properties": {
        "protocol_version": { "$ref": "#/$defs/ProtocolVersion" },
        "transfer_id": { "$ref": "common.schema.json#/$defs/Id" },
        "ordinal": { "type": "integer", "minimum": 0, "maximum": 131071 },
        "total": { "type": "integer", "minimum": 1, "maximum": 131072 },
        "chunk_digest": { "$ref": "common.schema.json#/$defs/Digest" },
        "full_digest": { "$ref": "common.schema.json#/$defs/Digest" },
        "payload_base64": { "type": "string", "maxLength": 87384, "contentEncoding": "base64" },
        "trace": { "$ref": "common.schema.json#/$defs/Trace" }
      }
    },
    "BindPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "render_mode", "overflow_policy", "refusal_policy", "config_digest"],
      "properties": {
        "mode": { "$ref": "#/$defs/Mode" },
        "render_mode": { "$ref": "#/$defs/RenderMode" },
        "overflow_policy": { "$ref": "#/$defs/OverflowPolicy" },
        "refusal_policy": { "$ref": "#/$defs/RefusalPolicy" },
        "config_digest": { "$ref": "common.schema.json#/$defs/Digest" },
        "parent_session_id": { "$ref": "common.schema.json#/$defs/Id" },
        "spawn_cursor": { "$ref": "common.schema.json#/$defs/Cursor" }
      }
    },
    "RebindPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["previous_scope", "next_scope", "reason"],
      "properties": {
        "previous_scope": { "$ref": "common.schema.json#/$defs/Scope" },
        "next_scope": { "$ref": "common.schema.json#/$defs/Scope" },
        "reason": { "type": "string", "minLength": 1, "maxLength": 1024 }
      }
    },
    "IngestPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["items"],
      "properties": {
        "items": { "type": "array", "minItems": 1, "maxItems": 10000, "items": { "$ref": "#/$defs/ContextItem" } }
      }
    },
    "ProjectPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_cursor", "provider_profile", "model_budget", "mode", "render_mode", "overflow_policy", "refusal_policy"],
      "properties": {
        "source_cursor": { "$ref": "common.schema.json#/$defs/Cursor" },
        "provider_profile": { "$ref": "#/$defs/ProviderProfile" },
        "model_budget": { "$ref": "#/$defs/ModelBudget" },
        "mode": { "$ref": "#/$defs/Mode" },
        "render_mode": { "$ref": "#/$defs/RenderMode" },
        "overflow_policy": { "$ref": "#/$defs/OverflowPolicy" },
        "refusal_policy": { "$ref": "#/$defs/RefusalPolicy" },
        "force_boundary": { "type": "boolean", "default": false },
        "boundary_reason": { "$ref": "#/$defs/ReasonCode" }
      }
    },
    "SummaryClaimPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["worker_id", "max_jobs"],
      "properties": {
        "worker_id": { "$ref": "common.schema.json#/$defs/Id" },
        "max_jobs": { "type": "integer", "minimum": 1, "maximum": 32 }
      }
    },
    "SummaryPublishPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["job_id", "lease_id", "source_digest", "tiers", "importance"],
      "properties": {
        "job_id": { "$ref": "common.schema.json#/$defs/Id" },
        "lease_id": { "$ref": "common.schema.json#/$defs/Id" },
        "source_digest": { "$ref": "common.schema.json#/$defs/Digest" },
        "tiers": { "type": "array", "minItems": 4, "maxItems": 4, "items": { "$ref": "#/$defs/SummaryTier" } },
        "importance": { "type": "number", "minimum": 0, "maximum": 1 },
        "facts": { "type": "array", "maxItems": 256, "items": { "type": "string", "maxLength": 4096 } },
        "events": { "type": "array", "maxItems": 256, "items": { "type": "string", "maxLength": 4096 } }
      }
    },
    "ConfigurePayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["previous_config_digest", "next_config_digest", "mode", "overflow_policy", "refusal_policy", "features"],
      "properties": {
        "previous_config_digest": { "$ref": "common.schema.json#/$defs/Digest" },
        "next_config_digest": { "$ref": "common.schema.json#/$defs/Digest" },
        "mode": { "$ref": "#/$defs/Mode" },
        "overflow_policy": { "$ref": "#/$defs/OverflowPolicy" },
        "refusal_policy": { "$ref": "#/$defs/RefusalPolicy" },
        "features": {
          "type": "object",
          "additionalProperties": false,
          "required": ["background_summaries", "reduction_tools", "automatic_reclaim", "nudges", "subagent_contributions", "synthetic_hook_blocks"],
          "properties": {
            "background_summaries": { "type": "boolean" },
            "reduction_tools": { "type": "boolean" },
            "automatic_reclaim": { "type": "boolean" },
            "nudges": { "type": "boolean" },
            "subagent_contributions": { "type": "boolean" },
            "synthetic_hook_blocks": { "type": "boolean" }
          }
        }
      }
    },
    "SubagentSpawnPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["child_session_id", "spawn_cursor", "mode_ceiling", "provider_profile_digest", "model_budget", "item_ids"],
      "properties": {
        "child_session_id": { "$ref": "common.schema.json#/$defs/Id" },
        "spawn_cursor": { "$ref": "common.schema.json#/$defs/Cursor" },
        "mode_ceiling": { "$ref": "#/$defs/Mode" },
        "provider_profile_digest": { "$ref": "common.schema.json#/$defs/Digest" },
        "model_budget": { "$ref": "#/$defs/ModelBudget" },
        "item_ids": { "type": "array", "maxItems": 100000, "items": { "$ref": "common.schema.json#/$defs/Id" } }
      }
    },
    "SubagentContributionPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["child_session_id", "child_cursor", "content", "content_digest", "authorized_by"],
      "properties": {
        "child_session_id": { "$ref": "common.schema.json#/$defs/Id" },
        "child_cursor": { "$ref": "common.schema.json#/$defs/Cursor" },
        "content": { "type": "string", "minLength": 1, "maxLength": 1048576 },
        "content_digest": { "$ref": "common.schema.json#/$defs/Digest" },
        "authorized_by": { "$ref": "common.schema.json#/$defs/Id" }
      }
    },
    "DiagnosePayload": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "include_recent": { "type": "boolean", "default": true },
        "max_outcomes": { "type": "integer", "minimum": 0, "maximum": 256, "default": 64 }
      }
    },
    "ProtocolRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol_version", "operation", "scope", "trace", "session_id", "render_mode", "payload"],
      "properties": {
        "protocol_version": { "$ref": "#/$defs/ProtocolVersion" },
        "operation": { "$ref": "#/$defs/Operation" },
        "scope": { "$ref": "common.schema.json#/$defs/Scope" },
        "trace": { "$ref": "common.schema.json#/$defs/Trace" },
        "session_id": { "$ref": "common.schema.json#/$defs/Id" },
        "render_mode": { "$ref": "#/$defs/RenderMode" },
        "expected_cursor": { "$ref": "common.schema.json#/$defs/Cursor" },
        "writer_lease": { "$ref": "#/$defs/WriterLease" },
        "idempotency_key": { "$ref": "common.schema.json#/$defs/Id" },
        "payload": {}
      },
      "allOf": [
        {
          "if": { "properties": { "operation": { "const": "bind" } }, "required": ["operation"] },
          "then": { "properties": { "payload": { "$ref": "#/$defs/BindPayload" } } }
        },
        {
          "if": { "properties": { "operation": { "const": "rebind" } }, "required": ["operation"] },
          "then": { "required": ["expected_cursor", "writer_lease", "idempotency_key"], "properties": { "payload": { "$ref": "#/$defs/RebindPayload" } } }
        },
        {
          "if": { "properties": { "operation": { "const": "ingest" } }, "required": ["operation"] },
          "then": { "required": ["expected_cursor", "writer_lease", "idempotency_key"], "properties": { "payload": { "$ref": "#/$defs/IngestPayload" } } }
        },
        {
          "if": { "properties": { "operation": { "const": "project" } }, "required": ["operation"] },
          "then": { "required": ["expected_cursor", "idempotency_key"], "properties": { "payload": { "$ref": "#/$defs/ProjectPayload" } } }
        },
        {
          "if": { "properties": { "operation": { "const": "project" }, "payload": { "properties": { "mode": { "const": "primary" } }, "required": ["mode"] } }, "required": ["operation", "payload"] },
          "then": { "required": ["writer_lease"] }
        },
        {
          "if": { "properties": { "operation": { "const": "reduce" } }, "required": ["operation"] },
          "then": { "required": ["expected_cursor", "writer_lease", "idempotency_key"], "properties": { "payload": { "$ref": "#/$defs/ReductionRequest" } } }
        },
        {
          "if": { "properties": { "operation": { "enum": ["expand", "recover"] } }, "required": ["operation"] },
          "then": { "properties": { "payload": { "$ref": "#/$defs/RecoveryRequest" } } }
        },
        {
          "if": { "properties": { "operation": { "const": "summary_claim" } }, "required": ["operation"] },
          "then": { "properties": { "payload": { "$ref": "#/$defs/SummaryClaimPayload" } } }
        },
        {
          "if": { "properties": { "operation": { "const": "summary_publish" } }, "required": ["operation"] },
          "then": { "required": ["expected_cursor", "writer_lease", "idempotency_key"], "properties": { "payload": { "$ref": "#/$defs/SummaryPublishPayload" } } }
        },
        {
          "if": { "properties": { "operation": { "const": "configure" } }, "required": ["operation"] },
          "then": { "required": ["expected_cursor", "writer_lease", "idempotency_key"], "properties": { "payload": { "$ref": "#/$defs/ConfigurePayload" } } }
        },
        {
          "if": { "properties": { "operation": { "const": "subagent_spawn" } }, "required": ["operation"] },
          "then": { "required": ["expected_cursor", "writer_lease", "idempotency_key"], "properties": { "payload": { "$ref": "#/$defs/SubagentSpawnPayload" } } }
        },
        {
          "if": { "properties": { "operation": { "const": "subagent_contribute" } }, "required": ["operation"] },
          "then": { "required": ["expected_cursor", "writer_lease", "idempotency_key"], "properties": { "payload": { "$ref": "#/$defs/SubagentContributionPayload" } } }
        },
        {
          "if": { "properties": { "operation": { "const": "export" } }, "required": ["operation"] },
          "then": { "properties": { "payload": { "$ref": "#/$defs/ExportPayload" } } }
        },
        {
          "if": { "properties": { "operation": { "const": "import" } }, "required": ["operation"] },
          "then": { "required": ["expected_cursor", "writer_lease", "idempotency_key"], "properties": { "payload": { "$ref": "#/$defs/ImportPayload" } } }
        },
        {
          "if": { "properties": { "operation": { "const": "diagnose" } }, "required": ["operation"] },
          "then": { "properties": { "payload": { "$ref": "#/$defs/DiagnosePayload" } } }
        }
      ]
    },
    "ProtocolResult": {
      "oneOf": [
        { "$ref": "#/$defs/SessionBinding" },
        { "$ref": "#/$defs/Projection" },
        { "$ref": "#/$defs/SummaryJob" },
        { "$ref": "#/$defs/SummaryRecord" },
        { "$ref": "#/$defs/ReductionResult" },
        { "$ref": "#/$defs/RecoveryResult" },
        { "$ref": "#/$defs/SubagentSnapshot" },
        { "$ref": "#/$defs/PortabilityManifest" },
        { "$ref": "#/$defs/ContextDiagnostics" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status"],
          "properties": {
            "status": { "type": "string", "enum": ["accepted", "queued", "committed", "unchanged", "empty"] },
            "accepted": { "type": "integer", "minimum": 0, "maximum": 1000000 },
            "rejected": { "type": "integer", "minimum": 0, "maximum": 1000000 },
            "policy_revision": { "type": "integer", "minimum": 1 },
            "config_digest": { "$ref": "common.schema.json#/$defs/Digest" }
          }
        }
      ]
    },
    "ProtocolResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol_version", "operation", "scope", "trace", "session_id", "cursor", "ok"],
      "properties": {
        "protocol_version": { "$ref": "#/$defs/ProtocolVersion" },
        "operation": { "$ref": "#/$defs/Operation" },
        "scope": { "$ref": "common.schema.json#/$defs/Scope" },
        "trace": { "$ref": "common.schema.json#/$defs/Trace" },
        "session_id": { "$ref": "common.schema.json#/$defs/Id" },
        "cursor": { "$ref": "common.schema.json#/$defs/Cursor" },
        "ok": { "type": "boolean" },
        "result": { "$ref": "#/$defs/ProtocolResult" },
        "error": { "$ref": "common.schema.json#/$defs/Error" }
      },
      "allOf": [
        {
          "if": { "properties": { "ok": { "const": true } }, "required": ["ok"] },
          "then": { "required": ["result"], "not": { "required": ["error"] } }
        },
        {
          "if": { "properties": { "ok": { "const": false } }, "required": ["ok"] },
          "then": { "required": ["error"], "not": { "required": ["result"] } }
        }
      ]
    }
  }
}
