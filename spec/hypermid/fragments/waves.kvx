[req.wave-8]
title = "Complete OSS distribution"
ac_1 = "A clean supported installation completes the full capability inventory through Gideon, including Python and other SDK contracts, native surfaces, SQLite and declared PostgreSQL backend behavior."
ac_2 = "The release receipt binds exact artifacts and source revisions to required results; cost and latency measurements identify workload and provider, and incomplete external checks prevent a fully-qualified release claim."

