[req.wave-4]
title = "Budgeted background knowledge maintenance"
ac_1 = "The user enables scheduled maintenance, sets its model and budget, observes one completed history and knowledge cycle, and inspects note conditions, code verification and git-derived recall."
ac_2 = "Cancellation, stale content hashes, exceeded budget and foreign ownership prevent unintended writes; edited memories invalidate every affected embedding and sharing judgment."

