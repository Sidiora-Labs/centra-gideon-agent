[req.wave-7]
title = "Lifecycle and native administration"
ac_1 = "A local owner upgrades an installation, migrates existing Gideon knowledge, exports and restores a complete project, and operates diagnostics and maintenance from the native console and CLI."
ac_2 = "Interrupted migrations resume safely, incompatible downgrades refuse, deletion removes derived copies according to policy, and rollback retains original journals and user credentials."

