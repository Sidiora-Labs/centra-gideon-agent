[req.wave-5]
title = "Supervised capability ecosystem"
ac_1 = "A scoped local module exposes a tool and a model capability through the daemon, the Python host and other SDKs consume versioned contracts, and the MCP bridge completes and cancels a real invocation."
ac_2 = "Restart, route replacement, slow consumption and deadline expiry preserve attribution and flow control; an unknown external effect is reconciled rather than automatically reissued."

