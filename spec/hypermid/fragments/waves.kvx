[req.wave-6]
title = "Durable events and optional remote access"
ac_1 = "The user subscribes to durable module events, resumes from a cursor after reconnect, and uses explicitly enabled remote transport with authenticated principals and OS containment."
ac_2 = "Expired grants, wrong owner, stale route epoch and replayed delivery are refused; unacknowledged effects prevent destructive disposal, and remote transport remains disabled by default."

