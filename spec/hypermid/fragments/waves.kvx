[req.wave-3]
title = "Bounded cached context and recall"
ac_1 = "A long conversation uses a stable serialized baseline and bounded delta, runs hybrid recall over the selected project sources, and shows source provenance and pressure in the native inspector."
ac_2 = "Unchanged passes preserve exact prefix bytes, changes publish at allowed boundaries, every outgoing request fits its declared model budget, and lexical-only mode remains usable."

