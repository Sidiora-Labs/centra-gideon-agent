[req.wave-1]
title = "Local session connection"
ac_1 = "A local OSS user starts Gideon with Hypermid available, authenticates the adapter to the local daemon, sees module health, and completes a normal conversation through a byte-preserving pass-through projection."
ac_2 = "Default context ownership remains with the existing runtime; missing daemon, invalid handshake and shutdown expose truthful status without losing the journal or duplicating a delivered answer."

[task.wave-1-close]
title = "Qualify vertical slice: Local session connection"
status = "done"
wave = 1
owner_lane = "integration"
requires = []
reqs = ["wave-1.1", "wave-1.2"]
touches = ["checks/hypermid/waves/test_wave_01.py", "spec/hypermid/qualification/wave-1.json"]
do_1 = "Implement the declared vertical user journey with the actual OSS runtime, stores and module processes, including failure and recovery paths."
do_2 = "Record source-bound results using the evidence contract; do not substitute a schema check or synthetic success for runtime acceptance."
verify_cmd = "python -m pytest checks/hypermid/waves/test_wave_01.py -q"

[req.wave-2]
title = "Durable project continuity"
ac_1 = "An opted-in project publishes a validated history segment and an owned memory, restarts Gideon and the daemon, and can recall the memory and expand the exact original source bytes."
ac_2 = "A forced interruption at each declared publication boundary leaves either the prior checkpoint or a recoverable committed publication; a second context writer is fenced."

[task.wave-2-close]
