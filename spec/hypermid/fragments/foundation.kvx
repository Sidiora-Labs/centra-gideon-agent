[task.base-05]
title = "Message-plane contracts and topology"
status = "pending"
wave = 5
owner_lane = "foundation"
requires = ["base-04"]
reqs = ["base-bus.1", "base-bus.2"]
acceptance = "Bus traits, naming, limits, grants, queue disposal, and parity classifications are complete before backend binding."
ac_1 = "Topology fixtures reject malformed tokens, overlapping subjects, escaping consumer filters, short backing-store retention, and permissions broader than the role."
ac_2 = "Trait fixtures cover message digests, one-in-flight cursors, revision snapshots, neutral census disconnects, bounded queue exhaustion, and dead-letter-before-term ordering."
touches = ["crates/hypermid-bus-contracts/Cargo.toml", "crates/hypermid-bus-contracts/src/lib.rs", "crates/hypermid-bus-contracts/src/stream.rs", "crates/hypermid-bus-contracts/src/register.rs", "crates/hypermid-bus-contracts/src/work_queue.rs", "crates/hypermid-bus-contracts/src/conformance.rs", "crates/hypermid-bus-naming/Cargo.toml", "crates/hypermid-bus-naming/src/lib.rs", "crates/hypermid-bus-naming/src/names.rs", "crates/hypermid-bus-naming/src/limits.rs", "crates/hypermid-bus-naming/src/grants.rs", "runtime/gideon/hypermid/bus.py", "checks/hypermid/test_base_bus_contracts.py"]
verify_cmd = "cargo test -p hypermid-bus-contracts -p hypermid-bus-naming --manifest-path Cargo.toml && PYTHONPATH=runtime python -m pytest -q checks/hypermid/test_base_bus_contracts.py"

