ac_2 = "The NATS backend binds only provisioned resources and passes restart, credential rotation, rekey, grant denial, revocation, sentinel attribution, leaf, and system-event cases."
touches = ["crates/hypermid-bus-memory/Cargo.toml", "crates/hypermid-bus-memory/src/lib.rs", "crates/hypermid-bus-memory/src/backend.rs", "crates/hypermid-bus-nats/Cargo.toml", "crates/hypermid-bus-nats/src/lib.rs", "crates/hypermid-bus-nats/src/connection.rs", "crates/hypermid-bus-nats/src/stream.rs", "crates/hypermid-bus-nats/src/register.rs", "crates/hypermid-bus-nats/src/work_queue.rs", "checks/hypermid/test_base_bus_backends.py"]
