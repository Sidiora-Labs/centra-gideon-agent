status = "pending"
wave = 4
owner_lane = "foundation"
requires = ["base-03"]
reqs = ["base-observability.1", "base-observability.2", "base-observability.3"]
acceptance = "Versioned HPKE envelopes and redacted fleet logs have explicit, cross-language-safe wire and failure contracts."
ac_1 = "Seal/open fixtures cover anonymous, authenticated, downgrade, rotation-key, tamper, malformed, bad-key, and plaintext-limit behavior."
ac_2 = "Logging fixtures prove canonical parsing, secret removal, control escaping, multi-writer complete lines, daily retention, capture rotation, and once-only fallback diagnostics."
touches = ["crates/hypermid-push/Cargo.toml", "crates/hypermid-push/src/lib.rs", "crates/hypermid-log/Cargo.toml", "crates/hypermid-log/src/lib.rs", "crates/hypermid-log/src/filter.rs", "crates/hypermid-log/src/format.rs", "crates/hypermid-log/src/redaction.rs", "crates/hypermid-log/src/segment.rs", "crates/hypermid-log/src/sink.rs", "runtime/gideon/hypermid/observability.py", "checks/hypermid/test_base_observability.py"]
