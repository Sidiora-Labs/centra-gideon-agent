[design.fabric]
contract = "Hypermid is a local-first authenticated process fabric implemented in Rust and consumed by Gideon through a typed Python adapter. It owns module discovery, supervision, routing, flow control, durable effects, events, diagnostics, registry lifecycle, service integration, and optional federation."
source = "spec/hypermid/design/fabric.txt"
schema = "spec/hypermid/schemas/fabric.schema.json"
capability_map = "spec/hypermid/maps/fabric.json"
verification_policy = "verify_cmd values are future implementation gates and are not run during specification"
protocol = "hypermid.v1"
framing = "Four-byte unsigned big-endian JSON byte length, maximum 8 MiB; streamed event data uses digest-checked chunks no larger than 64 KiB."
local_transport = "Owner-only Unix domain socket on Unix; owner-protected connection record and authenticated loopback on Windows."
external_transport = "Disabled by default; explicit listener requires TLS 1.3 and principal scopes."
trust = "Only authenticated principals and daemon-stamped supervised spawn identities grant authority. Client labels and payload fields never grant authority."

[req.fab-001]
title = "Versioned bounded JSON framing"
status = "pending"
ac_1 = "Every post-handshake message uses protocol hypermid.v1 and a four-byte unsigned big-endian JSON byte length that is rejected above 8 MiB before allocation."
ac_2 = "Event bodies larger than 64 KiB are emitted as ordered chunks no larger than 64 KiB with a whole-event SHA-256 digest and deterministic reassembly refusal."

[req.fab-002]
title = "Authenticated local and external sessions"
status = "pending"
ac_1 = "Unix local sessions use an owner-only socket plus peer evidence and HMAC proof; Windows uses an owner-only connection record plus authenticated loopback."
ac_2 = "External listeners remain absent by default and, when enabled, refuse sessions lacking TLS 1.3 identity and the required principal scopes."

[req.fab-003]
title = "Validated module discovery and manifests"
status = "pending"
ac_1 = "Discovery reads only configured roots, validates canonical executable paths, manifest versions, ids, dependency cycles, capability conflicts, and SHA-256 artifact digests before changing the registry generation."
ac_2 = "A discovered module remains unroutable until its one-use launch secret proves the expected module id and spawn generation and its operation catalog validates."
ac_3 = "The manifest vocabulary covers control surfaces, operation providers, pipeline stages, internal services, event publishers, event consumers, federation gateways, and maintenance workers without requiring a foreign service."

[req.fab-004]
title = "Epoch-safe route lifecycle"
status = "pending"
ac_1 = "Route creation becomes visible only after the selected ready module acknowledges the bind; failed binds release every reservation."
ac_2 = "Every routed frame is checked against route id and route epoch, and stale epochs or revoked scope produce typed terminal closure without reaching a reused route slot."

[req.fab-005]
title = "Bounded flow control"
status = "pending"
ac_1 = "Each route has independent request and byte credits, while control traffic has a separate bounded queue."
ac_2 = "Slow or disconnected consumers cannot grow memory without bound or consume another route's capacity, and terminal frames deterministically release request credit."

[req.fab-006]
title = "Cancellation and absolute deadlines"
status = "pending"
ac_1 = "A request deadline is converted once to a monotonic budget and is never extended across internal hops, route reopen, or retry."
ac_2 = "Cancellation is idempotent by message id, reaches queued or running work, discards later non-terminal output, and yields at most one terminal classification."

[req.fab-007]
title = "Crash-contained module supervision"
status = "pending"
ac_1 = "Each module follows the declared lifecycle state machine with bounded restart windows, exponential backoff, drain deadlines, and retained terminal evidence."
ac_2 = "Linux cgroups, Windows Job Objects, and pid-plus-start-time process identity contain descendants and prevent stale process ids from being killed after daemon restart."

[req.fab-008]
title = "Safe replacement and registry reconciliation"
status = "pending"
ac_1 = "Registry rescan provides preview and apply modes and atomically increments generation only after the complete candidate manifest set validates."
ac_2 = "Overlap-safe modules may warm a replacement before atomic cutover; failed warmup leaves the incumbent serving and exclusive modules use ordered drain then restart."

[req.fab-009]
title = "Durable effect recovery"
status = "pending"
ac_1 = "Durable effects commit an intent with effect id and input digest before dispatch and commit a terminal result before acknowledging it."
ac_2 = "Restart reconciliation returns committed, not_started, or unknown and never blindly replays an effect that may have begun."

[req.fab-010]
title = "Durable scoped event bus"
status = "pending"
ac_1 = "Publish and subscribe enforce principal scopes, record ordered cursors, and support atomic snapshot plus retained replay plus live continuation."
ac_2 = "Delivery is at least once with explicit durable acknowledgement, bounded redelivery, and a dead-letter record preserving original id, topic, digest, delivery count, and reason."

[req.fab-011]
title = "Health and operational diagnostics"
status = "pending"
ac_1 = "Health combines process, registration, readiness, probe, resource, route-breaker, and dependency evidence without reporting unsupported measurements as zero."
ac_2 = "Operators can read bounded stderr, durable terminal history, active routes, resource readings, provenance, and spawn events even when a module is unhealthy."

[req.fab-012]
title = "Scoped control RPC"
status = "pending"
ac_1 = "The control plane exposes describe, registry, route, supervisor, effect, and event operations through the same authenticated envelope with operation-specific scopes."
ac_2 = "Mutations are idempotent by message id, responses identify their daemon or registry generation, and stale or lost subscription cursors return explicit recovery data."

[req.fab-013]
title = "Owned install update and uninstall"
status = "pending"
ac_1 = "Install and update accept only fresh signed index metadata and digest-verified artifacts, stage beside the active generation, and atomically activate or roll back."
ac_2 = "Uninstall and replacement mutate only ownership-ledger paths whose current digest still matches, preserving user stores and unrelated configuration."

[req.fab-014]
title = "Cross-platform daemon service integration"
status = "pending"
ac_1 = "Linux systemd user units, macOS LaunchAgents, and Windows scheduled tasks start the per-user daemon and preserve its ordered child shutdown window."
ac_2 = "Register, reload, start, stop, restart, and deregister return exact service-manager failures and apply changed definitions before restart."

[req.fab-015]
title = "Opt-in federated routing"
status = "pending"
ac_1 = "Paired peers use signed expiring discovery, direct-first dialing, mutually authenticated encrypted sessions, and separate single-use relay grants."
ac_2 = "Remote catalogs expose only explicitly remote operations, and the receiving fabric intersects remote grants with local scopes before dispatch."

[req.fab-016]
title = "Durable outbound phone channel"
status = "pending"
ac_1 = "The phone channel uses outbound-only federation and reconciles unsettled mutation effects before admitting another mutation after reconnect."
ac_2 = "Push notifications carry only opaque wake tokens and cannot contain commands, route credentials, request payloads, or assistant content."

[req.fab-017]
title = "Typed Gideon adapter"
status = "pending"
ac_1 = "The Python adapter maps the shared Id, Scope, Digest, Cursor, Error, and Trace contracts and exposes typed async control, route, event, cancellation, and effect-status calls."
ac_2 = "On daemon epoch change it invalidates route epochs and event cursors, refreshes snapshots, and never retries a durable effect without a conclusive status."

[task.fab-01-bootstrap]
title = "Implement authenticated framing minimal daemon and passthrough adapter"
status = "done"
wave = 1
owner_lane = "fabric"
requires = ["base-01"]
reqs = ["fab-001.1", "fab-001.2", "fab-002.1", "fab-002.2", "fab-017.1", "fab-017.2"]
touches = ["crates/hypermid-protocol/Cargo.toml", "crates/hypermid-protocol/src/lib.rs", "crates/hypermid-transport/Cargo.toml", "crates/hypermid-transport/src/lib.rs", "crates/hypermid-transport/src/framing.rs", "crates/hypermid-transport/src/handshake.rs", "crates/hypermid-transport/src/local.rs", "crates/hypermid-transport/src/tls.rs", "crates/hypermid-daemon/Cargo.toml", "crates/hypermid-daemon/src/main.rs", "runtime/gideon/hypermid/__init__.py", "runtime/gideon/hypermid/models.py", "runtime/gideon/hypermid/adapter.py", "crates/hypermid-transport/tests/protocol_vectors.rs", "checks/runtime/test_hypermid_adapter.py"]
acceptance = "Authenticated hypermid.v1 framing runs through a minimal daemon and the typed Gideon passthrough adapter."
ac_1 = "Golden vectors cover length boundaries, malformed JSON, handshake proof binding, and external TLS scope refusal."
ac_2 = "The focused gate exercises a real local socket through the Rust daemon and runtime/gideon/hypermid adapter without fake protocol implementations."
verify_cmd = "cargo test -p hypermid-protocol -p hypermid-transport -p hypermid-daemon && PYTHONPATH=runtime python -m pytest -q checks/runtime/test_hypermid_adapter.py"

[task.fab-02-registry-routing]
title = "Implement manifest registry and epoch-safe routing"
status = "done"
wave = 2
owner_lane = "fabric"
requires = ["fab-01-bootstrap", "base-02"]
reqs = ["fab-003.1", "fab-003.2", "fab-003.3", "fab-004.1", "fab-004.2"]
touches = ["crates/hypermid-control/Cargo.toml", "crates/hypermid-control/src/lib.rs", "crates/hypermid-daemon/Cargo.toml", "crates/hypermid-daemon/src/manifest.rs", "crates/hypermid-daemon/src/registry.rs", "crates/hypermid-daemon/src/router.rs", "crates/hypermid-daemon/tests/registry_routes.rs"]
acceptance = "Validated manifests register operations and routes bind atomically with enforced epochs."
ac_1 = "Invalid roots, digests, ids, dependency cycles, capability conflicts, and launch identities fail before the registry generation changes."
ac_2 = "A stale route epoch cannot deliver to a new binding even when the route id is reused."
verify_cmd = "cargo test -p hypermid-daemon --test registry_routes"

[task.fab-03-flow-lifecycle]
title = "Implement flow control cancellation and deadlines"
status = "done"
wave = 3
owner_lane = "fabric"
requires = ["fab-01-bootstrap", "fab-02-registry-routing", "base-03"]
reqs = ["fab-005.1", "fab-005.2", "fab-006.1", "fab-006.2"]
touches = ["crates/hypermid-daemon/src/flow.rs", "crates/hypermid-daemon/src/connection.rs", "crates/hypermid-daemon/src/deadline.rs", "crates/hypermid-daemon/src/cancellation.rs", "crates/hypermid-daemon/tests/flow_lifecycle.rs"]
acceptance = "Every route and connection remains bounded while cancellation and deadline outcomes are terminal and race safe."
ac_1 = "Credit exhaustion blocks or refuses only the affected route while control traffic remains responsive."
ac_2 = "Cancel, timeout, response, and disconnect races produce exactly one terminal result and leave no credit or request entry leaked."
verify_cmd = "cargo test -p hypermid-daemon --test flow_lifecycle"

[task.fab-04-control-diagnostics]
title = "Implement scoped control RPC health and diagnostics"
status = "done"
wave = 4
owner_lane = "fabric"
requires = ["fab-01-bootstrap", "fab-02-registry-routing", "fab-03-flow-lifecycle"]
reqs = ["fab-011.1", "fab-011.2", "fab-012.1", "fab-012.2"]
touches = ["crates/hypermid-control/Cargo.toml", "crates/hypermid-control/src/lib.rs", "crates/hypermid-control/src/operations.rs", "crates/hypermid-daemon/src/control.rs", "crates/hypermid-daemon/src/health.rs", "crates/hypermid-daemon/src/diagnostics.rs", "crates/hypermid-daemon/tests/control_diagnostics.rs", "runtime/gideon/hypermid/subscriptions.py"]
acceptance = "Scoped control operations expose live and retained health evidence through Rust contracts and the Gideon adapter."
ac_1 = "Every control operation enforces its principal scope and returns idempotent mutation results with daemon or registry generation."
ac_2 = "Health and diagnostics remain readable during failure and report unavailable evidence and subscription gaps explicitly."
verify_cmd = "cargo test -p hypermid-control && cargo test -p hypermid-daemon --test control_diagnostics && PYTHONPATH=runtime python -m pytest -q checks/runtime/test_hypermid_adapter.py"

[task.fab-05-supervision]
title = "Implement advanced contained module supervision and replacement"
status = "pending"
wave = 5
owner_lane = "fabric"
requires = ["fab-01-bootstrap", "fab-02-registry-routing", "fab-03-flow-lifecycle", "fab-04-control-diagnostics", "base-07"]
reqs = ["fab-007.1", "fab-007.2", "fab-008.1", "fab-008.2"]
touches = ["crates/hypermid-daemon/src/supervisor.rs", "crates/hypermid-daemon/src/containment.rs", "crates/hypermid-daemon/src/replacement.rs", "crates/hypermid-daemon/src/child_journal.rs", "crates/hypermid-daemon/tests/supervision.rs"]
acceptance = "All declared module system roles are contained, replaceable, health checked, and diagnosable through retained evidence without requiring a foreign service."
ac_1 = "Crash, failed warmup, hung drain, daemon restart, and stale pid scenarios preserve the lifecycle and containment invariants."
ac_2 = "Overlap-safe cutover and exclusive restart preserve route ownership and leave the incumbent serving when replacement warmup fails."
verify_cmd = "cargo test -p hypermid-daemon --test supervision"

[task.fab-06-effects-federation]
title = "Implement durable event bus federation and phone effect channel"
status = "pending"
wave = 6
owner_lane = "fabric"
requires = ["fab-01-bootstrap", "fab-02-registry-routing", "fab-03-flow-lifecycle", "fab-04-control-diagnostics", "fab-05-supervision", "base-06"]
reqs = ["fab-009.1", "fab-009.2", "fab-010.1", "fab-010.2", "fab-015.1", "fab-015.2", "fab-016.1", "fab-016.2"]
touches = ["crates/hypermid-bus/Cargo.toml", "crates/hypermid-bus/src/lib.rs", "crates/hypermid-bus/src/effects.rs", "crates/hypermid-bus/src/events.rs", "crates/hypermid-bus/src/journal.rs", "crates/hypermid-bus/src/dead_letter.rs", "crates/hypermid-bus/src/bridge.rs", "crates/hypermid-bus/src/remote_effects.rs", "crates/hypermid-transport/src/federation.rs", "crates/hypermid-transport/src/relay.rs", "crates/hypermid-daemon/src/federation.rs", "crates/hypermid-bus/tests/recovery.rs", "crates/hypermid-daemon/tests/federation.rs"]
acceptance = "The self-contained durable bus, optional bridge, paired federation, and outbound phone origins preserve scoped ordering and effect recovery."
ac_1 = "Kill-window recovery demonstrates intent-before-dispatch and result-before-ack without requiring a foreign broker."
ac_2 = "Direct and relay reconnect scenarios enforce grants and settle committed or not_started mutations while uncertain mutations remain unknown."
verify_cmd = "cargo test -p hypermid-transport && cargo test -p hypermid-bus --test recovery && cargo test -p hypermid-daemon --test federation"

[task.fab-07-registry-service]
title = "Implement owned install update and service lifecycle"
status = "pending"
wave = 7
owner_lane = "fabric"
requires = ["fab-01-bootstrap", "fab-02-registry-routing", "fab-03-flow-lifecycle", "fab-04-control-diagnostics", "fab-05-supervision", "fab-06-effects-federation", "sec-06"]
reqs = ["fab-013.1", "fab-013.2", "fab-014.1", "fab-014.2"]
touches = ["crates/hypermid-registry/Cargo.toml", "crates/hypermid-registry/src/lib.rs", "crates/hypermid-registry/src/ownership.rs", "crates/hypermid-registry/src/release_index.rs", "crates/hypermid-registry/src/activation.rs", "crates/hypermid-registry/src/service/linux.rs", "crates/hypermid-registry/src/service/macos.rs", "crates/hypermid-registry/src/service/windows.rs", "crates/hypermid-registry/tests/lifecycle.rs"]
acceptance = "Owned artifacts and per-user daemon services install, update, roll back, and uninstall without mutating unowned state."
ac_1 = "Signature, freshness, digest, compatibility, collision, activation, and rollback failure paths stop at their declared boundary."
ac_2 = "Each platform service definition preserves ordered child shutdown and returns exact manager errors through the registry API."
verify_cmd = "cargo test -p hypermid-registry --test lifecycle"

[task.fab-08-integration]
title = "Qualify the complete OSS process fabric"
status = "pending"
wave = 8
owner_lane = "fabric"
requires = ["fab-01-bootstrap", "fab-02-registry-routing", "fab-03-flow-lifecycle", "fab-04-control-diagnostics", "fab-05-supervision", "fab-06-effects-federation", "fab-07-registry-service"]
reqs = ["fab-001.1", "fab-001.2", "fab-002.1", "fab-002.2", "fab-003.1", "fab-003.2", "fab-003.3", "fab-004.1", "fab-004.2", "fab-005.1", "fab-005.2", "fab-006.1", "fab-006.2", "fab-007.1", "fab-007.2", "fab-008.1", "fab-008.2", "fab-009.1", "fab-009.2", "fab-010.1", "fab-010.2", "fab-011.1", "fab-011.2", "fab-012.1", "fab-012.2", "fab-013.1", "fab-013.2", "fab-014.1", "fab-014.2", "fab-015.1", "fab-015.2", "fab-016.1", "fab-016.2", "fab-017.1", "fab-017.2"]
touches = ["crates/hypermid-daemon/tests/oss_fabric.rs", "checks/runtime/test_hypermid_adapter.py", "spec/hypermid/schemas/fabric.schema.json", "spec/hypermid/maps/fabric.json"]
acceptance = "The complete OSS fabric runs end to end from Gideon adapter through authenticated daemon routing, supervised modules, durable events and effects, optional federation, registry update, and recovery."
ac_1 = "The aggregate journey uses real processes and durable stores and records every required capability without placeholder or foreign-service dependencies."
ac_2 = "Restart, route epoch, cursor gap, effect ambiguity, rollback, and service lifecycle evidence remain explicit and no partial gate is presented as release certification."
verify_cmd = "cargo test -p hypermid-protocol -p hypermid-transport -p hypermid-control -p hypermid-daemon -p hypermid-bus -p hypermid-registry && PYTHONPATH=runtime python -m pytest -q checks/runtime/test_hypermid_adapter.py"
