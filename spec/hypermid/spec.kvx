[design.context]
document = "spec/hypermid/design/context.txt"
contract = "Hypermid owns immutable context state and deterministic projections behind a bounded versioned protocol; runtime/gideon/hypermid is the first adapter and Gideon remains the product authority for sessions, providers, tools, and authorization."

[req.ctx-ownership]
title = "Bounded protocol and context ownership"
acceptance = "Define and enforce the authority boundary between Gideon and the independent Hypermid engine."
ac_1 = "Each UTF-8 JSON envelope uses a four-byte unsigned big-endian length, stays within eight MiB, uses digest-checked ordered chunks of at most 64 KiB for larger logical inputs, and rejects unsupported, oversized, stale, incomplete, or scope-mismatched work before state changes."
ac_2 = "Gideon owns authorization, provider credentials, tool execution, final delivery, session lifecycle, and the authoritative transcript while Hypermid owns only its source references and derived projection, summary, reduction, cache, lease, and diagnostic state."
ac_3 = "Exactly one fenced writer lease can advance a session cursor, and repeated mutation idempotency keys return the recorded outcome without advancing it again."

[req.ctx-identity]
title = "Stable scoped context identity"
acceptance = "Keep context identities stable through retries, restarts, provider changes, edits, forks, and imports."
ac_1 = "Sessions, journal items, tool calls, derived summaries, projections, and subagent snapshots have stable non-empty identifiers and explicit relation fields instead of position-derived identity."
ac_2 = "Owner or project mismatch fails closed, workspace changes require a recorded rebind, and reconnecting or replaying an acknowledged append cannot create a second item."

[req.ctx-history]
title = "Immutable history and exact recovery"
acceptance = "Preserve an append-only context journal that can reproduce every accepted original item."
ac_1 = "Ingest atomically validates Gideon source identity and digest, ordering, tool-call/result linkage, expected cursor, and idempotency before appending a reference or matching snapshot; summaries and reductions never overwrite source items."
ac_2 = "Exact recovery by item id, reclaim tag, or cursor range resolves the authoritative Gideon content through the scoped adapter and verifies its digest, including content absent from the current projection."
ac_3 = "Corrections, edits, tombstones, regeneration, and forks append explicit relations and do not renumber or silently mutate prior entries."

[req.ctx-projection]
title = "Deterministic context projection"
acceptance = "Derive reproducible provider-ready context from a committed journal cursor."
ac_1 = "A projection records source range and digest, policy revision, mode, provider profile, budget inputs, selected identities, region digests, and output digest."
ac_2 = "The same journal cursor and request inputs produce byte-identical normalized projection output, and no projection mutates the journal."

[req.ctx-provider-serialization]
title = "Capability-driven provider serialization"
acceptance = "Serialize valid provider requests without coupling the engine to provider credentials or SDKs."
ac_1 = "Provider capability profiles cover context and output limits, supported roles and parts, tool adjacency, reasoning, attachments, and cache boundaries; unsupported combinations are rejected before dispatch."
ac_2 = "The explicit host_serialized render mode returns language-independent normalized blocks and ModelBudget values; Gideon's HostSerializer preserves tool pairing and order, excludes internal metadata, and reports a canonical serialized digest before dispatch."
ac_3 = "A provider-profile change creates a new projection generation and never reinterprets stored source bytes in place."

[req.ctx-cache-policy]
title = "Stable baseline and delta cache policy"
acceptance = "Preserve reusable prompt prefixes while admitting new durable context at explicit boundaries."
ac_1 = "Managed projections expose separately digested baseline, delta, and live-tail regions; replay returns byte-identical baseline and delta bytes."
ac_2 = "Delta refresh changes only delta bytes, while baseline folds occur only for a declared hard-boundary reason and atomically advance the cache generation."
ac_3 = "Reduction or decay changes that affect cached bytes wait for a compatible boundary unless the declared overflow policy records and returns a pressure refusal."

[req.ctx-tier-decay]
title = "Budgeted tier decay"
acceptance = "Degrade older history predictably while protecting current work and important anchors."
ac_1 = "Every summarized span has four ordered immutable detail tiers, and tier selection accounts for age, importance, protection, recurrence, dependency reach, and available budget."
ac_2 = "Tier decisions remain fixed for a cache generation and reserve output, the live tail, active tool pairs, latest user request, approvals, and protected-window capacity first."

[req.ctx-background-summary]
title = "Background summary pipeline"
acceptance = "Build derived historical summaries off the active turn with bounded, validated jobs."
ac_1 = "Summary jobs carry source cursor range and digest, tier schema, locale, token limits, lease, and opaque job id; per-session single flight and bounded global concurrency prevent duplicate work."
ac_2 = "Only a structurally valid candidate matching the current source digest and live lease commits atomically; stale, empty, malformed, cancelled, or timed-out work cannot alter projection state."
ac_3 = "The immutable journal can rebuild all summary records after loss, and summary-model usage is recorded separately from foreground usage."

[req.ctx-reduction]
title = "Explicit recoverable reduction"
acceptance = "Let agents request context removal by stable tags without losing authoritative content."
ac_1 = "Reduction accepts tags and ranges idempotently, reports accepted and rejected targets individually, and rejects foreign, unknown, protected, provider-framing, active, or already summarized targets."
ac_2 = "Applied reductions use typed markers with identity, size, and exact recovery instructions, while latest user input, active tool pairs, approvals, control messages, and the protected tail remain present."

[req.ctx-reclaim]
title = "Deterministic pressure reclaim"
acceptance = "Recover context budget through safe ordered policies and refuse unsafe overflow."
ac_1 = "Reclaim ranks explicit reductions, superseded edits, obsolete or completed tool output, historical detail, and unprotected prose by recoverable size, age, dependency safety, and content class."
ac_2 = "Advisory, action, emergency, and hard-wall pressure bands use calibrated provider mass; the hard wall refuses the call when no safe plan fits instead of sending unmanaged or silently truncated input."
ac_3 = "Every reclaim plan records chosen candidates, exclusions, reason codes, estimated savings, and the compatible boundary where it applied."

[req.ctx-recovery]
title = "Crash-safe projection recovery"
acceptance = "Rebuild state from the journal and safely replay a compatible last-known-good projection."
ac_1 = "The engine stores a complete last-known-good normalized projection with cursor, generation, provider-profile digest, policy revision, and region digests before publication."
ac_2 = "Replay is allowed only when every binding and budget input still matches; otherwise the adapter returns a retryable refusal and never dispatches an unmanaged prompt."
ac_3 = "Corrupt or partial derived records are quarantined and observable, and journal replay can reconstruct projection state without source loss."

[req.ctx-subagents]
title = "Isolated subagent context"
acceptance = "Give delegated work bounded inherited context without sharing mutable context authority."
ac_1 = "A child receives a distinct session identity and immutable spawn snapshot containing parent link, cursor, allowed regions, scope, mode ceiling, provider profile, and budget."
ac_2 = "Child writes, summaries, reductions, and cache generations remain child-owned; a parent contribution requires Gideon authorization and appends as a new parent item with child identity and digest."
ac_3 = "Child usage and context outcomes remain separately attributable while supporting bounded roll-up diagnostics."

[req.ctx-hooks]
title = "Context lifecycle hooks"
acceptance = "Expose deterministic, bounded extension points around context operations."
ac_1 = "Lifecycle events cover bind, ingest, projection, pressure, reduction, summary, recovery, subagent snapshot, and faults with scope, trace, session, cursor, policy revision, and redacted metadata."
ac_2 = "Pre hooks may deny or return bounded synthetic blocks with identities and digests but cannot rewrite journal items; timeouts and exceptions cannot leave partial mutations."
ac_3 = "Post hooks run after commit and are advisory, with every hook outcome recorded under the originating trace."

[req.ctx-modes]
title = "Optional context modes and features"
acceptance = "Support off, pass-through, shadow, and primary operation with explicit overflow and refusal policy."
ac_1 = "off leaves Hypermid inactive, pass_through observes health while preserving Gideon request bytes, shadow computes locally without model calls, durable mutation, publication, or serving-cursor advance, and primary serves verified projections under a fenced lease."
ac_2 = "Background summaries, reduction tools, automatic reclaim, nudges, subagent contributions, and synthetic hook blocks are independently configurable with safe defaults."
ac_3 = "Strict behavior is selected through overflow_policy and refusal_policy; configuration changes take effect only at a turn boundary, advance policy revision when bytes may change, and preserve prior and next digests."

[req.ctx-diagnostics]
title = "Context diagnostics and accounting"
acceptance = "Make every context decision, cost, and failure inspectable without exposing content by default."
ac_1 = "Status includes cursor, generation, scope binding, mode, provider-profile digest, journal and region sizes, calibrated mass, budget, selected tiers, protected items, pending reductions, summary work, and recovery eligibility."
ac_2 = "Decision records carry one reason code and Trace, while accounting distinguishes no call, missing usage, zero usage, cache reads and writes, summaries, and subagents."
ac_3 = "Diagnostic output is redacted and bounded by default, rotates safely, and remains available when the engine cannot answer."

[req.ctx-portability]
title = "Context migration, export, and restore"
acceptance = "Move context state without changing authoritative history, scope, identity, or cache semantics."
ac_1 = "Canonical export includes session binding, ordered source references, derived records, policy revisions, cache generations, reductions, and manifest digests while excluding credentials, live leases, transient queues, and SDK payloads."
ac_2 = "Import is staged, bounded, scope checked, digest verified, idempotent, and invisible until the entire manifest commits."
ac_3 = "Migration resumes from a committed cursor without duplication, restore rebuilds derived state from verified sources, and failed cutover retains the previous authority at a quiescent turn boundary."

[req.ctx-gideon-adapter]
title = "Installed Gideon pass-through adapter and status"
acceptance = "Install and supervise Hypermid in Gideon without changing provider input before primary projection is enabled."
ac_1 = "Gideon supervises the local engine, negotiates protocol version and transport limits, binds authenticated scope, and exposes redacted availability, version, mode, cursor, and lease status."
ac_2 = "off and pass_through preserve Gideon's existing assembled provider request bytes and cannot publish context state; shadow may compare a local projection but makes no model calls or durable writes and advances no serving cursor."
ac_3 = "Engine startup, handshake, timeout, or disconnect failure preserves the existing Gideon request path and records an unavailable status without claiming Hypermid served the turn."

[req.ctx-gideon-integration]
title = "OSS Gideon context integration"
acceptance = "Use Hypermid for complete native-agent context management while preserving Gideon authority."
ac_1 = "Before each primary-mode model turn Gideon binds the session, appends newly committed items, supplies provider capabilities and safe budget, runs hooks, requests a projection, serializes it, and verifies its digest before dispatch."
ac_2 = "Assistant and tool events append after the turn, while stop, edit/resend, regenerate, fork, compaction, provider failover, and subagent spawn use explicit protocol operations."
ac_3 = "Existing Gideon authorization, approval, cancellation, streaming, provider selection, and transcript persistence remain authoritative, and every primary-mode provider call has a recorded projection or policy-selected refusal."

[task.ctx-ownership]
title = "Implement the bounded context protocol and ownership fence"
status = "pending"
wave = 1
