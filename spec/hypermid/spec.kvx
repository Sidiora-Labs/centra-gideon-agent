reqs = ["ctx-ownership.1", "ctx-ownership.2", "ctx-ownership.3"]
touches = ["crates/hypermid-core/src/protocol.rs", "crates/hypermid-context/src/engine.rs", "runtime/gideon/hypermid/protocol.py", "runtime/gideon/hypermid/ownership.py", "crates/hypermid-context/tests/protocol_contract.rs", "checks/runtime/test_hypermid_protocol.py"]
