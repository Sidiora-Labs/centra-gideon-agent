[req.int-03]
title = "Cache policy, hybrid recall and native inspection"
acceptance = "Compose deterministic cache-aware context and hybrid recall with explainable results in existing Gideon surfaces."
ac_1 = "Context assembly preserves ordered components, source provenance, prompt-cache boundaries, provider-served context windows and headroom decisions; a summary or cached component is rejected when its covered digest or policy version differs."
ac_2 = "Hybrid recall combines keyword, vector and graph arms without widening Scope, reports per-arm scores and omissions, and retains Gideon's keyword fallback when embeddings are absent or unhealthy."
ac_3 = "The native console and CLI inspect the active writer, cursor, digest, cache state, recall arms and provenance without exposing raw private content or credentials."

