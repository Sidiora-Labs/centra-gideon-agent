acceptance = "A versioned transport offers equivalent in-process and authenticated local-bus semantics with bounded streams, cancellation, backpressure, cursor replay, and mutation idempotency."
ac_1 = "Shared conformance vectors return equivalent records, errors, traces, cursors, and stream termination over both transports."
ac_2 = "Forged transport identity, replayed mutation keys, disconnected consumers, and resumed cursors cannot broaden Scope authority or duplicate committed mutations."
