ac_1 = "Contract conformance preserves shared Scope, Cursor, Error, and Trace values across Python and Rust for success, conflict, authorization refusal, and cancellation."
ac_2 = "OSS lifecycle startup, health, drain, and shutdown preserve durable work and keep lexical retrieval available when vector providers are disabled."
touches = ["crates/hypermid-memory/src/api.rs", "crates/hypermid-memory/src/ffi.rs", "runtime/gideon/hypermid/__init__.py", "runtime/gideon/hypermid/contracts.py", "runtime/gideon/hypermid/client.py", "runtime/gideon/hypermid/lifecycle.py", "checks/hypermid/test_memory_clients.py"]
