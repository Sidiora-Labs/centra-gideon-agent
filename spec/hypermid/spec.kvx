[req.int-02]
title = "Durable summaries, memory CRUD and raw recovery"
acceptance = "Make Hypermid an opt-in scoped writer for digest-bound context and the complete existing memory surface, with recoverable append-only raw data."
ac_1 = "Shadow remains read-only; primary can start only after dirty Gideon writes flush, background summarization and consolidation quiesce, source digests validate, and a monotonically increasing scoped writer lease is granted."
ac_2 = "Raw knowledge events are append-only, cursor ordered and digest chained; memory deletion, undo and supersession append events, summaries carry the covered Gideon source digest, and ConversationLog remains the sole transcript authority."
ac_3 = "Semantic, episodic, lesson, slot, graph, page, event-audit, undo, embedding, keyword fallback, statistics and context-preview operations remain reachable through MemoryService-compatible results with privacy modes preserved."
ac_4 = "A crash-recovery journey replays the knowledge event journal, discards summaries whose Gideon source digest no longer matches, reconstructs the same memory records, and resumes at the next cursor without duplicate writes."

