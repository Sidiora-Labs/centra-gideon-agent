[req.int-05]
title = "Supervised tool and model modules with SDK and MCP lifecycle"
acceptance = "Expose Hypermid modules through Gideon's supervised SDK and MCP boundaries while retaining the native model loop, tool policy, approvals and credentials."
ac_1 = "Hypermid module discovery and invocation enter through ToolCatalog-compatible definitions, portable schemas and existing approval/risk policy; the daemon cannot invoke a tool, resolve an approval or open an MCP connection independently."
ac_2 = "Model work continues through ModelProvider.stream with served-model identity, provider fallback, cache usage and UsageJournal accounting intact; no provider or OAuth credential is serialized into a Hypermid request."
ac_3 = "SDK and MCP connections are scoped, health-reported, cancelled and evicted with their Gideon session, and daemon shutdown leaves no live module child or pooled MCP connection."

