[req.int-08]
title = "Whole OSS conformance, packaging and release readiness"
acceptance = "Qualify one installable OSS system across off, shadow and primary modes without any external control-plane dependency."
ac_1 = "A clean local package and single-container install includes the daemon binary, Python adapter, schema, CLI and console, runs unprivileged over a local transport, persists under the configured root and remains off by default."
ac_2 = "The real end-to-end matrix covers off, pass_through, shadow and primary and proves single-writer behavior, no shadow writes, raw recovery, migration and rollback, N/N-1 compatibility, scoped recall, cancellation ownership, MCP and sandbox cleanup, provider usage accounting, unchanged approvals and exactly-once final delivery."
ac_3 = "The release-readiness report distinguishes source checks from live journeys, records every unsupported platform or unqualified path, and contains no claim of a separate deployment release."

