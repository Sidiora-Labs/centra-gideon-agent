ac_1 = "Compaction conformance proves setup purity, delta cursor recovery, range structure, strict request/deadline fencing, rising versions, bounded wait/ready, and every crash point."
ac_2 = "Transform conformance proves declaration bounds, ordering and exclusive replacement, phase-answer legality, explicit grants, questions, failure policy, purity, and crash recovery."
