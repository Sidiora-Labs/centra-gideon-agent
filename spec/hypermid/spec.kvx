[design.integration_artifacts]
feature = "hypermid-integration"
status = "pending"
version = "1.0.0"
scope = "oss"
owner_lane = "integration"
design = "spec/hypermid/design/gideon-integration.txt"
seam_map = "spec/hypermid/maps/gideon-seams.json"
config_schema = "spec/hypermid/schemas/config.schema.json"

[design.gideon_architecture]
contract = "Hypermid has four principal integration components (foundation/contracts, context, memory, daemon/fabric) backed by the shared Rust workspace and integrated only through runtime/gideon/hypermid. Shared wire types come from hypermid-protocol and hypermid-contracts; Gideon retains ConversationLog, the model/tool loop, provider credentials, approvals, usage ledger, final response, delivery, and product surfaces."
delivery = "The complete local daemon, adapter, migration, rollback, CLI, console, packaging, and conformance journey ships in OSS before any separate deployment work."
default = "Wave 1 is authenticated local pass-through and status only. Gideon remains the sole default writer. Hypermid ownership is opt-in from wave 2 onward after a scoped barrier and writer lease."

[design.invariants]
single_writer = "Exactly one context writer exists for each owner/project/workspace scope. Shadow is read-only and cannot summarize, append, mutate memory, or update an index."
raw_integrity = "Raw Hypermid knowledge events are append-only and digest chained. Memory supersession, deletion, undo and rollback append new events. Gideon ConversationLog remains transcript authority, and derived summaries are admitted only against its covered source digest."
runtime_authority = "NativeAgentRuntime, ModelProvider, ToolCatalog, McpClientRegistry, ApprovalGate, ConversationDirectory, run_chat, ResultDelivery and UsageJournal retain their current authority."
cancellation = "ConversationDirectory remains the surface authority. Before daemon acceptance Python owns cancellation; after acceptance the daemon exclusively owns the request token and Rust children until it returns an effect-state receipt."
secrets = "No provider, subscription, OAuth, MCP, channel or environment credential crosses the Hypermid protocol."
compatibility = "Handshake negotiation, N and N-1 protocol support, copy-validate-cutover migration, retained rollback checkpoints and unknown-effect reconciliation are mandatory."

[req.int-01]
title = "Authenticated local daemon and pass-through integration"
acceptance = "Install and supervise the local Hypermid daemon behind a scoped authenticated adapter without replacing any active Gideon writer or user path."
ac_1 = "A real local daemon built from the shared Rust workspace completes an authenticated handshake carrying Scope(owner_id, project_id, optional workspace_id), protocol range, storage version, build version and capabilities; incompatible or unauthenticated clients are refused with the shared Error shape."
ac_2 = "In off and pass-through modes, context, memory, model, tool, approval, usage, final delivery and persistence results are byte-for-byte or structurally identical to the existing Gideon path, and status proves Gideon is the sole writer."
ac_3 = "RuntimeProcess starts, health-checks and drains the daemon over authenticated Unix sockets or Windows loopback TCP; process existence without protocol and digest health is reported unhealthy, and a non-loopback listener is refused."

[task.int-01]
