[design.surfaces]
contract = "Native OSS Gideon console, CLI, desktop, HostAdapter, and generic client experience for Hypermid administration and inspection. The Rust daemon/core remains authoritative and Gideon's Python adapter owns host translation. No duplicate standalone web UI and no hosted rollout."
wire = "Hypermid v1 uses a four-byte big-endian JSON length, an 8 MiB frame ceiling, ordered chunks no larger than 64 KiB, authenticated local Unix or Windows loopback transport, and explicit TLS opt-in for remote access."
truth = "Surfaces adopt authoritative cursors, expected digests, typed effect outcomes, and terminal receipts. HTTP completion, process exit, schema presence, optimistic state, or reconnect alone never proves a mutation committed."
navigation = "Use Gideon's existing Settings, Diagnostics, Connections, terminal, shared headers, cards, forms, tables, dialogs, and responsive shell. Hypermid is one native destination with progressive disclosure, not a catch-all panel or separate web application."
clients = "Python is required for the Gideon HostAdapter. Rust, TypeScript, and Swift clients provide wire and outcome parity. Generic SDKs may ship in OSS; they do not imply hosted availability."
integration = "A full HostAdapter negotiates identity, scopes, sessions, memory, configuration, credentials, lifecycle, cursors, and reconnect. An MCP bridge exposes bounded tools only and is labeled separately."
accessibility = "Keyboard, touch, screen-reader, reduced-motion, focus, announcements, linear reading order, 44px targets, 320/390px layouts, and high-risk review flows are first-class acceptance criteria."

[req.ux-contract]
title = "Versioned clients and full HostAdapter negotiation"
acceptance = "All language clients and Gideon's Python HostAdapter agree on framing, scope, correlation, cursor, error, chunk, cancellation, reconnect, and mutation-outcome behavior."
ac_1 = "Python, Rust, TypeScript, and Swift clients decode the same golden request, response, event, error, and chunk vectors and reject a declared frame above 8 MiB before allocating its body."
ac_2 = "The Python HostAdapter negotiates only implemented capabilities and refuses a request whose owner/project/workspace mapping cannot be proven; an MCP bridge never satisfies the full-host capability set."
ac_3 = "After disconnect, a mutating call that may have been accepted returns outcome unknown and is not automatically retried; reconnect uses a new authenticated handshake and explicit cursor resume."

[req.ux-inspection]
title = "Native sessions, memory, and cache inspection"
acceptance = "Users inspect live and durable Hypermid state inside Gideon's native console with scoped filters, linked evidence, stable cursors, and truthful empty or degraded states."
ac_1 = "A session timeline renders turns, tool activity, memory and cache decisions, compaction boundaries, errors, and trace links once in cursor order across reconnect and snapshot adoption."
ac_2 = "Memory detail exposes scope, revision, lineage, source, verification, contradiction, embedding, and retrieval evidence while preserving anchor immutability and draft-on-conflict behavior."
ac_3 = "Cache inventory distinguishes complete, filtered, stale, rebuilding, unavailable, and unreadable states and plans clear/rebuild effects before mutation."

[req.ux-configuration]
title = "Scoped runtime, model, and credential configuration"
acceptance = "Configuration surfaces show effective values, sources, editability, revisions, readiness, and redacted credential metadata without exposing secret values."
ac_1 = "Runtime mode offers exactly off, pass_through, shadow, and primary; strictness remains a separate policy field, and a stale configuration or model-binding write is refused while the user's dirty fields remain available for compare, reload, or reapply."
ac_2 = "Model readiness comes from a real required probe, and unknown cost, usage, context, or health remains unknown rather than zero or ready."
ac_3 = "Credential list, replace, validate, and delete flows expose presence and consumers only; diagnostics, events, and exports contain no secret value or reusable local authentication material."

[req.ux-operations]
title = "Diagnostics and maintenance control plane"
acceptance = "Operators can observe health and run authorized maintenance through bounded plans, cursored progress, and terminal receipts."
ac_1 = "Diagnostics names observed state, timestamp, Scope, cache age, transport/adapter/client compatibility, process health, and a specific next action; reruns preserve the previous result until a new result arrives."
ac_2 = "Maintenance apply requires the reviewed plan digest, rechecks authority and blockers, streams ordered progress, and ends in committed, failed, cancelled, or outcome-unknown state."
ac_3 = "Live logs resume from a Cursor or display an explicit gap and redact secrets before storage, streaming, filtering, copying, or export."

[req.ux-lifecycle]
title = "Install, update, uninstall, migration, and export journeys"
acceptance = "Every lifecycle mutation follows plan, review, apply, progress, and receipt stages with explicit data retention, rollback, and interruption semantics."
ac_1 = "Install and update validate platform, permissions, protected connection material, compatibility floors, migrations, space, drain, restart, and rollback requirements before apply."
ac_2 = "Uninstall inventories runtime wiring and user data separately and cannot purge data unless the reviewed plan explicitly chose purge and the current authority permits it."
ac_3 = "Migration stages and validates before visibility and is idempotent; export returns a verified artifact digest and excludes derivatives, credentials, and local authentication material."

[req.ux-integrations]
title = "MCP bridge, supervised stdio, and bounded conditions"
acceptance = "Tool bridges, child processes, and local conditions expose useful integration behavior without gaining undeclared host authority or arbitrary execution."
ac_1 = "Connections labels Tool bridge and Full host integration separately, and tool availability alone never implies session, configuration, credential, lifecycle, or cursor-resume coverage."
ac_2 = "A stdio child starts with an allowlisted environment, bounded initialization/request/frame/idle budgets, isolated failure, and close-wait-terminate-reap shutdown; post-write timeout or cancellation returns outcome unknown."
ac_3 = "File and git conditions revalidate authorized roots and repository identity, use no shell interpolation or network, emit stable transition occurrences, and return bounded observed facts."

[req.ux-remote]
title = "Remote, mobile, and accessible operation"
acceptance = "Opt-in TLS remote operation and responsive native views preserve scope, truth, safety, and accessibility across desktop and mobile."
ac_1 = "Remote enablement requires TLS, named device enrollment, scoped expiry, and capability review; revocation blocks a fresh session and no transport silently downgrades."
ac_2 = "At 320 and 390 CSS pixels inspection, filters, plan review, progress, cancellation, and receipt recovery work without horizontal page scrolling or hidden required actions."
ac_3 = "Keyboard and screen-reader journeys announce validation, stream gaps, and terminal outcomes once, preserve focus and drafts, meet 44px touch targets, and provide a linear alternative to dense tables or timelines."

[req.ux-native]
title = "Complete first OSS native slice"
acceptance = "The existing Gideon console route, CLI, and desktop shell complete the same real-daemon journey through the Python HostAdapter and Rust authority."
ac_1 = "A user can inspect one session and linked memory/cache evidence, change an allowed setting, run a maintenance plan, and verify its receipt without entering raw identifiers or JSON."
ac_2 = "The CLI provides human-readable and JSON modes for status, inspect, config, maintenance, lifecycle, conditions, and export, with stable exit classes and no interactive prompt when non-interactive input is detected."
ac_3 = "Desktop local mode owns daemon start/stop and shutdown handoff without orphaning supervised children; web-only mode reports local operations unavailable instead of starting a local daemon."

