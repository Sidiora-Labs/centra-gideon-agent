ARG PYTHON_IMAGE=mirror.gcr.io/library/python:3.13-slim@sha256:bb2988715db2cf7ace7b53f38f3cffbef7c7046a656bee66245eb0ed386e2e81
ARG NODE_TOOLS_IMAGE=node:22-bookworm-slim@sha256:43ac6c60b8f89723f746e8a92ce91abd5017e627ce1ddfe4238355d3a30b772c
ARG RUST_IMAGE=rust:1.91.1-bookworm@sha256:c1e5f19e773b7878c3f7a805dd00a495e747acbdc76fb2337a4ebf0418896b33
ARG CONSOLE_IMAGE=mirror.gcr.io/library/node:24-alpine@sha256:ebfe2f90462722a7a4de65e91990e97fe0d401c70e0e762c5b53302f905ec1c1
FROM ${PYTHON_IMAGE} AS base
FROM ${NODE_TOOLS_IMAGE} AS node-tools
FROM ${RUST_IMAGE} AS hypermid-builder
ARG CARGO_BUILD_JOBS=2
ENV CARGO_BUILD_JOBS=${CARGO_BUILD_JOBS}
WORKDIR /build
COPY rust-toolchain.toml Cargo.toml Cargo.lock ./
COPY crates/ ./crates/
RUN cargo build --locked --release -p hypermid-daemon
FROM base AS deps
WORKDIR /build
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    gcc \
    libolm-dev \
    && rm -rf /var/lib/apt/lists/*
ARG UV_VERSION=0.12.19
RUN pip install --no-cache-dir --root-user-action=ignore "uv==${UV_VERSION}"
RUN python -m venv /opt/venv && \
    /opt/venv/bin/pip install --no-cache-dir wheel "setuptools==83.0.0"
COPY pyproject.toml uv.lock ./
RUN uv export --locked --no-emit-project --emit-index-url \
    --extra slack --extra eval --extra httpx --extra anthropic --extra openai \
    --extra embeddings --extra stt --extra tts --extra channels \
    -o /build/requirements.txt && \
    /opt/venv/bin/pip install --no-cache-dir --require-hashes --no-deps \
    -r /build/requirements.txt

FROM deps AS builder
COPY runtime/ ./runtime/
COPY spec/hypermid/schemas/ ./spec/hypermid/schemas/
COPY pyproject.toml setup.py ./
COPY --from=hypermid-builder /build/target/release/hypermid-daemon /tmp/hypermid-daemon
RUN rm -rf build/ *.egg-info && \
    GIDEON_PREBUILT_HYPERMID_DAEMON=/tmp/hypermid-daemon \
    /opt/venv/bin/pip install --no-cache-dir --no-deps --no-build-isolation . && \
    rm -f /tmp/hypermid-daemon

FROM builder AS test
RUN uv export --locked --no-emit-project --emit-index-url --extra dev \
    -o /build/requirements-dev.txt && \
    /opt/venv/bin/pip install --no-cache-dir --require-hashes --no-deps \
    -r /build/requirements-dev.txt
COPY checks/ ./checks/
COPY tooling/ ./tooling/
RUN /opt/venv/bin/python -m black --check runtime/gideon checks/runtime && \
    /opt/venv/bin/python -m isort --check-only runtime/gideon checks/runtime && \
    /opt/venv/bin/python -m flake8 runtime/gideon checks/runtime && \
    /opt/venv/bin/python -m mypy runtime/gideon || true && \
    /opt/venv/bin/python -m pytest
FROM base AS runtime
RUN apt-get update && apt-get install -y --no-install-recommends \
    tini \
    curl \
    ffmpeg \
    git \
    libolm3 \
    && rm -rf /var/lib/apt/lists/*
COPY --from=node-tools /usr/local/bin/node /usr/local/bin/node
COPY --from=node-tools /usr/local/lib/node_modules /usr/local/lib/node_modules
RUN ln -s ../lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm && \
    ln -s ../lib/node_modules/npm/bin/npx-cli.js /usr/local/bin/npx
RUN npm install -g --no-fund --no-audit \
    @agentclientprotocol/claude-agent-acp \
    @agentclientprotocol/codex-acp \
    @anthropic-ai/claude-code \
    @openai/codex \
    && npm cache clean --force || true
RUN groupadd --gid 10001 gideon && \
    useradd --uid 10001 --gid 10001 --create-home --shell /bin/false gideon
COPY --from=builder /opt/venv /opt/venv
COPY --from=hypermid-builder /build/target/release/hypermid-daemon /usr/local/bin/hypermid-daemon
RUN chmod 0755 /usr/local/bin/hypermid-daemon
ENV PLAYWRIGHT_BROWSERS_PATH=/opt/playwright
RUN /opt/venv/bin/pip install --no-cache-dir 'playwright>=1.40' && \
    /opt/venv/bin/python -m playwright install --with-deps chromium && \
    chmod -R a+rX /opt/playwright && \
    rm -rf /var/lib/apt/lists/*
RUN BRIDGE_DIR="$(/opt/venv/bin/python -c 'from pathlib import Path; import gideon.integrations.messaging_channels as m; print(Path(m.__file__).parent / "bridge")')" && \
    npm ci --prefix "$BRIDGE_DIR" --omit=dev --no-audit --no-fund
ENV PATH="/opt/venv/bin:$PATH" \
    PYTHONUNBUFFERED=1 \
    GIDEON_HOME=/data \
    GIDEON_WORKSPACE=/data/workspace \
    GIDEON_PORT=10000 \
    GIDEON_INSTALL_KIND=container \
    GIDEON_CONTAINER_STARTED_BY=docker-run \
    GIDEON_CONTAINER_IMAGE=gideon-gateway:local
RUN mkdir -p /data && chown gideon:gideon /data
VOLUME ["/data"]
USER gideon
WORKDIR /data
EXPOSE 10000
HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
    CMD curl -fsS http://127.0.0.1:10000/api/healthz || exit 1
ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["gideon", "gateway"]

FROM ${CONSOLE_IMAGE} AS console
WORKDIR /app
COPY package.json package-lock.json ./
COPY apps/console/package.json apps/console/
COPY apps/assistant/package.json apps/assistant/package-lock.json apps/assistant/
RUN npm ci --workspace=apps/console --prefer-offline && \
    npm ci --prefix apps/assistant --prefer-offline
COPY apps/console/ apps/console/
COPY apps/assistant/ apps/assistant/
COPY runtime/gideon/security/scan_rule_gloss.json runtime/gideon/security/scan_rule_gloss.json
COPY runtime/gideon/workspace/genui_v2_catalog.json runtime/gideon/workspace/genui_v2_catalog.json
RUN npm exec --workspace=apps/console -- vite build

FROM runtime AS single
USER root
COPY --from=console /app/apps/console/dist /tmp/gideon-console-dist
RUN python -c 'from pathlib import Path; import shutil, sysconfig; shutil.copytree("/tmp/gideon-console-dist", Path(sysconfig.get_path("purelib")) / "gideon/static/dist", dirs_exist_ok=True)' && \
    rm -rf /tmp/gideon-console-dist
ENV GIDEON_DOCKER_MODE=single GIDEON_CONTAINER_IMAGE=gideon:local GIDEON_BIND_HOST=0.0.0.0
USER gideon

FROM runtime AS default
