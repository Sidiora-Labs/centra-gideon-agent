schema_version = 1
scope = "oss"
title = "Gideon technical gotchas"

[[gotcha]]
id = "channels-client-array"
status = "resolved"
symptom = "Channel controls fail when treating api.channels() as an object containing another channels field."
cause = "The HTTP response contains channels, but the shared client already unwraps that field and returns ChannelRuntime[]."
prevention = "Consume the returned array directly; keep HTTP envelopes and client return types distinct."
source = ["apps/console/src/shared/data/api.ts", "apps/console/src/features/settings/ChannelOwnerSection.tsx"]
evidence = ["apps/console/src/features/settings/ApprovalChannelSection.tsx"]

[[gotcha]]
id = "query-cache-scope"
status = "resolved"
symptom = "A filtered or conditional request can replace a complete collection cached under the same query key."
cause = "useQuery shares results by key; the key must include any condition that changes the returned set."
prevention = "Keep full, archived, filtered and conditional results under distinct keys. Chat lists separate active and archived keys; channel configuration reads use their own keys."
source = ["apps/console/src/shared/data/data/useQuery.ts", "apps/console/src/features/ChatPage.tsx", "apps/console/src/features/apps/AppsSection.tsx"]
evidence = ["apps/console/src/shared/data/siblingCacheStaleness.test.ts"]

[[gotcha]]
id = "revision-value-pair"
status = "resolved"
symptom = "A save is refused as stale, or an old draft can overwrite newer data if paired with a freshly fetched revision."
cause = "A revision describes exactly the value returned with it, not an unrelated draft or later read."
prevention = "Capture value and revision together, submit that revision through If-Match, and preserve the draft on refusal. Model binding calls use the revision returned by activeModels()."
source = ["apps/console/src/shared/data/staleWrite.ts", "apps/console/src/shared/data/useStaleWriteGuard.ts", "runtime/gideon/interfaces/dashboard/handlers/model_registry.py"]
evidence = ["apps/console/src/features/onboarding/essentialSetupState.ts", "apps/console/src/features/onboarding/BundledModelOffer.tsx"]

[[gotcha]]
id = "active-state-loop"
status = "resolved"
symptom = "Background notifications disappear or leave unawaited WebSocket send coroutines."
cause = "A background thread cannot schedule a coroutine with ensure_future without a running loop; a separate ConsoleState does not own the active clients."
prevention = "Use the active ConsoleState and its WebSocketState scheduling path. Off-loop sends are submitted to the captured gateway loop and disconnected clients are reaped."
source = ["runtime/gideon/interfaces/dashboard/state.py", "runtime/gideon/interfaces/dashboard/ws_state.py"]
evidence = ["runtime/gideon/interfaces/dashboard/server.py"]

[[gotcha]]
id = "accepted-action-receipt"
status = "resolved"
symptom = "The interface clears or replaces a chat before a stop, edit or regenerate request has actually been accepted."
cause = "HTTP completion alone does not establish application acceptance or supply an authoritative transcript snapshot."
prevention = "Require ok=true and the accepted snapshot before adopting chat changes; retain the existing transcript and draft on refusal."
source = ["apps/console/src/features/chat/turnOutcome.ts", "runtime/gideon/interfaces/dashboard/chat_handlers.py", "runtime/gideon/interfaces/dashboard/chat_regenerate.py"]
evidence = ["apps/console/src/features/chat/chatActionsAreTransactional.test.tsx", "checks/runtime/test_chat_turn_outcome.py"]

[[gotcha]]
id = "terminal-snapshot-replay"
status = "resolved"
symptom = "A completed answer appears twice after reconnecting or adopting a detail snapshot."
cause = "Persisted chunks can produce a streaming projection alongside the terminal assistant row; replay without its epoch, turn and sequence watermark repeats content."
prevention = "Normalize only the cursor-matched completed projection and fence replay with the authoritative snapshot cursor. Preserve unmatched older history."
source = ["apps/console/src/features/chat/snapshotReplay.ts", "apps/console/src/features/chat/useStreamCoalescer.ts"]
evidence = ["apps/console/src/features/chat/streamedAnswerRendersOnce.test.tsx", "checks/runtime/test_stream_resume_watermark.py"]

[[gotcha]]
id = "summary-digest"
status = "resolved"
symptom = "An old compressed summary supplies obsolete context after transcript edits or rewinds."
cause = "A file timestamp alone cannot prove that the summarized transcript prefix is unchanged."
prevention = "Keep the journal authoritative and append-only during compression. Use a derived summary only when the covered-prefix digest still matches; exclude summary sidecars from portability snapshots."
source = ["runtime/gideon/cognition/history.py", "runtime/gideon/cognition/bg_compress.py", "runtime/gideon/operations/durability/inventory.py"]
evidence = ["checks/runtime/test_compression_preserves_chat.py"]

[[gotcha]]
id = "channel-notification-thread"
status = "open"
symptom = "Channel notification delivery is skipped when invoked from a thread without a running event loop."
cause = "The channel notification helpers create tasks on get_running_loop; their RuntimeError handlers log and return. WebSocket thread-safe scheduling does not also schedule these channel sends."
prevention = "Invoke channel notifications on the active gateway loop. Thread-origin callers need explicit dispatch to that loop before channel delivery can be relied on."
source = ["runtime/gideon/interfaces/dashboard/state.py", "runtime/gideon/interfaces/dashboard/ws_state.py"]

[[gotcha]]
id = "oauth-challenge-discovery"
status = "resolved"
symptom = "A remote MCP sign-in fails when its resource metadata is served from another origin."
cause = "The first WWW-Authenticate parameter follows the Bearer scheme, and the challenge can arrive on an initialization POST. A GET-only parser that expects a comma before resource_metadata misses it."
prevention = "Parse the authentication scheme before its parameters and record metadata from same-origin 401 challenges regardless of request method. Require HTTPS and retain destination validation before dispatch."
source = ["runtime/gideon/integrations/mcp_client.py"]
evidence = ["checks/runtime/test_mcp_oauth_tenant_isolation.py"]

[[gotcha]]
id = "oauth-rejected-callback-cleanup"
status = "resolved"
symptom = "A rejected OAuth issuer leaves a callback future and authorization task waiting."
cause = "Consuming the pending state before rejecting the issuer removes the entry used by expiry pruning, while separate future and task registries still hold the attempt."
prevention = "On issuer rejection, remove and cancel the exact attempt's callback future and authorization task together with its consumed state."
source = ["runtime/gideon/integrations/mcp_oauth.py"]
evidence = ["checks/runtime/test_mcp_oauth_tenant_isolation.py"]
[[gotcha]]
id = "document-read-before-await"
status = "resolved"
symptom = "A slow edit request can overwrite a newer save even when it supplies a revision."
cause = "Reading the stored document before awaiting the request body makes the later revision check compare against an obsolete snapshot."
prevention = "Read the current document after body parsing and enforce the final write with the store's atomic expected-value check. Keep whole-document field and tag updates in the same conditional write."
source = ["runtime/gideon/interfaces/dashboard/handlers/knowledge.py", "runtime/gideon/cognition/knowledge/store.py"]
evidence = ["checks/runtime/test_stale_write_documents.py"]

[[gotcha]]
id = "task-revision-precision"
status = "resolved"
symptom = "Two immediate task edits can reuse one revision and let a stale editor save."
cause = "Second-precision timestamps cannot distinguish writes within the same second."
prevention = "Generate updated_at through the monotonic microsecond helper inside the task mutation lock, including checklist and reconciled writes."
source = ["runtime/gideon/engine/tasks/native.py"]
evidence = ["checks/runtime/test_stale_write_work_items.py"]

[[gotcha]]
id = "cached-file-authority"
status = "resolved"
symptom = "Reopening a cached dirty file draft prevents saving despite a retained revision and validator."
cause = "The editor's validator lookup is populated only from the latest read, leaving the cached draft's original revision without its raw-byte validator."
prevention = "Restore the cached revision-to-validator pair alongside the draft. Keep that original pair distinct from the latest read until an explicit rebase or successful save."
source = ["apps/console/src/features/files/browse/FileViewer.tsx", "apps/console/src/shared/ui/content/contentSurfaceState.ts"]
