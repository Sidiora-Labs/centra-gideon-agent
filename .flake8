[flake8]
exclude =
    apps/console/dist
    apps/console/node_modules
    apps/desktop/node_modules
    runtime/gideon/static/dist
    build
    dist
    node_modules
    venv
    .venv
    .git
    .mypy_cache
    .pytest_cache
    __pycache__

max-line-length = 120

extend-ignore =
    E704
    E203
    W503

per-file-ignores =
    runtime/gideon/interfaces/cli/main.py: E402
    __init__.py: F401
