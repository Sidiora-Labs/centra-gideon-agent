# GIDEON_HOME=/data

# GIDEON_PORT=10000

# GIDEON_BIND_HOST=127.0.0.1

# GIDEON_CORS_ORIGINS=

# GIDEON_IMAGE_TAG=latest

# GIDEON_AUTH_MODE=local_token

# GIDEON_API_KEY=   # ignored until the selector lands — see above

# GIDEON_CREDENTIAL_BACKEND=dotenv

# SLACK_APP_TOKEN=xapp-...
# SLACK_BOT_TOKEN=xoxb-...

# GIDEON_OWNER_ID=

# ANTHROPIC_API_KEY=sk-ant-...

# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=

# OLLAMA_HOST=127.0.0.1:11434

# SKILLS_SH_API_KEY=

# GIDEON_UPLOAD_LIMIT_VIDEO=3221225472       # 3 GiB video
# GIDEON_UPLOAD_LIMIT_IMAGE=524288000        # 500 MiB image
# GIDEON_UPLOAD_SINGLE_POST_THRESHOLD=52428800  # 50 MiB single-POST cutoff
# GIDEON_STT_SEGMENT_THRESHOLD=26214400      # 25 MiB

# GIDEON_DEV_MODE=

# GIDEON_AUTONUDGE=1

# GIDEON_PROJECT_DIR=

# GIDEON_WORKSPACE=

# Gideon publication sources (configure only with your actual release locations).
# GIDEON_RELEASE_REPOSITORY=owner/repository
# GIDEON_PACKAGE_SOURCE=/absolute/path/to/gideon-agent-harness
