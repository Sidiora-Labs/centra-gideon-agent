{
  "name": "@gideon/console",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Gideon web app — the dashboard UI",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.sw.json",
    "test": "vitest run",
    "audit:consistency": "GIDEON_WRITE_AUDIT=1 vitest run src/shared/theme/consistencyAudit.generate.test.ts",
    "test:watch": "vitest",
    "e2e": "playwright test --grep-invert @visual && playwright test --grep @visual",
    "e2e:visual": "playwright test e2e/visual.spec.ts",
    "e2e:a11y": "playwright test e2e/a11y.spec.ts",
    "e2e:update": "playwright test e2e/visual.spec.ts --update-snapshots",
    "e2e:report": "playwright show-report"
  },
  "dependencies": {
    "@antv/infographic": "^0.2.20",
    "@assistant-ui/ai-sdk": "0.0.8",
    "@assistant-ui/react": "0.15.22",
    "@assistant-ui/react-generative-ui": "0.0.21",
    "@assistant-ui/react-markdown": "0.14.17",
    "@assistant-ui/react-mcp": "0.1.20",
    "@assistant-ui/react-syntax-highlighter": "0.14.6",
    "@assistant-ui/store": "0.3.15",
    "@base-ui/react": "1.8.0",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.12.3",
    "@codemirror/state": "^6.7.5",
    "@codemirror/view": "^6.43.12",
    "@lezer/highlight": "^1.2.3",
    "@monaco-editor/react": "^4.7.0",
    "@radix-ui/react-popper": "1.3.7",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "beautiful-mermaid": "1.1.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cn": "0.3.0",
    "es-module-lexer": "^3.0.2",
    "framer-motion": "^13.4.0",
    "highlight.js": "^11.12.0",
    "katex": "^0.18.6",
    "lucide-react": "^1.47.0",
    "mermaid": "^12.0.0",
    "monaco-editor": "^0.56.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.4",
    "react-shiki": "0.11.1",
    "react-syntax-highlighter": "16.1.1",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "shiki": "4.4.3",
    "three": "0.186.1",
    "unified": "^11.0.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.0.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "5.0.0",
    "esbuild": "^0.28.2",
    "jsdom": "^30.0.1",
    "tailwindcss": "^4.0.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.0",
    "vitest": "5.0.0"
  }
}
