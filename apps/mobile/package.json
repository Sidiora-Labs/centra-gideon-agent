{
  "name": "gideon-mobile",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Capacitor shell that wraps the gateway's served companion route. Contains no copy of the companion UI.",
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "cap": "cap",
    "add:ios": "cap add ios",
    "add:android": "cap add android",
    "assets:ios": "npx -y @capacitor/assets generate --ios",
    "assets:android": "npx -y @capacitor/assets generate --android",
    "sync": "npm run copy:notices && cap sync",
    "open:ios": "cap open ios",
    "open:android": "cap open android",
    "build:ios": "npm run copy:notices && cap sync ios && cap build ios",
    "build:android": "npm run copy:notices && cap sync android && cap build android",
    "copy:notices": "node -e \"require('node:fs').copyFileSync('../console/dist/THIRD_PARTY_NOTICES.txt','www/THIRD_PARTY_NOTICES.txt')\"",
    "precap": "npm run copy:notices"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.1",
    "@capacitor/core": "^8.5.1",
    "@capacitor/ios": "^8.5.1",
    "@capacitor/push-notifications": "^8.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.1"
  }
}
