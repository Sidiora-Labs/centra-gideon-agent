{
  "name": "@gideon/assistant",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "start": "expo start --dev-client",
    "web": "node tooling/buildTrustedWebAssets.mjs --out-dir public/assets && expo start --web --port 8081",
    "build:web": "expo export --platform web --output-dir dist/web && node tooling/buildTrustedWebAssets.mjs --out-dir dist/web/assets && test -s dist/web/index.html && test -s dist/web/assets/gideon-console.css && test -s dist/web/assets/gideon-monaco-editor.worker.js && cp ../console/public/assistant-source-notices.txt dist/web/assistant-source-notices.txt",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@expo/metro-runtime": "6.1.2",
    "@monaco-editor/react": "4.7.0",
    "cn": "0.3.0",
    "es-module-lexer": "3.0.2",
    "expo": "54.0.0",
    "expo-status-bar": "3.0.0",
    "framer-motion": "13.4.3",
    "highlight.js": "11.12.0",
    "katex": "0.18.9",
    "lucide-react": "1.48.0",
    "lucide-react-native": "1.48.0",
    "mermaid": "12.0.0",
    "monaco-editor": "0.56.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-markdown": "10.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "5.6.0",
    "react-native-svg": "15.12.1",
    "react-native-web": "0.21.0",
    "rehype-katex": "7.0.1",
    "rehype-raw": "7.0.0",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0",
    "unified": "11.0.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/react": "19.1.0",
    "@types/react-dom": "19.1.0",
    "esbuild": "0.28.2",
    "postcss": "8.5.28",
    "typescript": "5.9.2",
    "vite": "8.3.1",
    "vitest": "3.2.4"
  },
  "main": "index.js"
}
