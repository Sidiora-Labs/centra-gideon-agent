{
  "name": "gideon-desktop",
  "version": "0.1.0",
  "description": "Gideon \u2014 AI agent desktop app",
  "license": "Apache-2.0",
  "desktopName": "gideon-desktop",
  "main": "src/application/main.js",
  "scripts": {
    "start": "electron .",
    "test": "mkdir -p ../../reports && node --test --test-reporter=spec --test-reporter-destination=stdout --test-reporter=junit --test-reporter-destination=../../reports/ci-web-desktop.junit.xml test/*.test.js",
    "dist": "electron-builder --mac --config.electronVersion=$(node -p \"require('electron/package.json').version\")",
    "dist:linux": "electron-builder --linux --config.electronVersion=$(node -p \"require('electron/package.json').version\")"
  },
  "devDependencies": {
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "io.gideon.app",
    "productName": "Gideon",
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "assets/gideon.png",
      "target": [
        "dmg"
      ]
    },
    "dmg": {
      "writeUpdateInfo": false
    },
    "linux": {
      "category": "Development",
      "icon": "assets/gideon.png",
      "maintainer": "Gideon contributors <maintainers@gideon.invalid>",
      "synopsis": "Gideon \u2014 AI agent desktop app",
      "syncDesktopName": true,
      "target": [
        "AppImage",
        "deb"
      ]
    },
    "files": [
      "src/application/main.js",
      "src/bridge/dashboard-preload.js",
      "src/bridge/connection-preload.js",
      "src/native/capabilities.js",
      "src/native/push-to-talk.js",
      "src/native/tray-presence.js",
      "src/native/login-item.js",
      "src/native/notifications.js",
      "src/native/context-menu.js",
      "src/gateway/executable.js",
      "src/gateway/environment.js",
      "src/gateway/shutdown.js",
      "src/connection/address.js",
      "src/storage/endpoint-registry.js",
      "src/storage/shell-store.js",
      "src/connection/controller.js",
      "src/connection/dialog.js",
      "views/connection.html",
      "views/loading.html",
      "assets/gideon.png",
      "src/gateway/login-path.js",
      "assets/gideon.svg",
      "src/application/window-workspace.js",
      "src/application/local-gateway.js",
      "src/application/endpoint-session.js",
      "src/application/desktop-application.js",
      "assets/gideon-dark.png",
      "assets/gideon-light.png",
      "assets/tray-dark.png",
      "assets/tray-light.png"
    ],
    "extraResources": [
      {
        "from": "backend-dist/gideon-backend",
        "to": "backend-dist/gideon-backend",
        "filter": [
          "**/*"
        ]
      }
    ],
    "publish": null
  },
  "private": true
}
