+def test_the_supervisor_starts_and_stops_an_sdk_worker(
+    tmp_path: Path, sup: WorkerSupervisor, monkeypatch: pytest.MonkeyPatch
+) -> None:
+    monkeypatch.delenv(WORKER_GRANT_ENV, raising=False)
+    ready = tmp_path / "sdk-ready"
+    body = (
+        "from pathlib import Path\n"
+        "from gideon.sdk.background import BackgroundWorker, run_worker\n"
+        "class Probe(BackgroundWorker):\n"
+        "    def run_once(self, ctx):\n"
+        f"        Path({str(ready)!r}).write_text(ctx.app_name + ':' + ctx.worker_id)\n"
+        "run_worker(Probe())\n"
+    )
+    manifest = _install_worker_app(
+        tmp_path,
+        "sdkprobe",
+        body=body,
+        workers=[worker_runtime.WorkerSpec(name="probe", entry_point="worker.py")],
+    )
+    (rec,) = sup.start(manifest)
+    _wait_for(
+        lambda: (ready.exists() and ready.stat().st_size > 0) or not rec.is_alive(),
+        what="the SDK worker's first unit of work",
+    )
+    assert rec.is_alive(), "the SDK worker exited before doing supervised work"
+    assert ready.read_text() == "sdkprobe:probe"
+    assert sup.stop("sdkprobe") == 1
+    assert rec.proc is not None and rec.proc.returncode == 0
+    assert sup.get("sdkprobe", "probe") is None
+
+
