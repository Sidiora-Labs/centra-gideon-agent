{
  "name": "gideon-experience",
  "version": "1.0.0",
  "displayName": "Interactive Stories",
  "description": "Author stories, operate durable world foundations, and compile bounded game exports with downloadable GLB assets.",
  "icon": "BookOpen",
  "author": "Gideon",
  "tags": ["tool", "bundled"],
  "provider": {
    "type": "tool",
    "implementation": "gideon.workspace.capabilities.experience.tools:create_provider",
    "capabilities": ["experience"]
  },
  "native": true,
  "providers": [
    {
      "type": "tool",
      "implementation": "gideon.workspace.capabilities.experience.world_foundations_provider:create_provider",
      "capabilities": ["experience_foundations_get", "experience_controller_install", "experience_controller_control"]
    },
    {
      "type": "tool",
      "implementation": "gideon.workspace.capabilities.experience.game_assets_provider:create_provider",
      "capabilities": ["experience_game_assets_get", "experience_game_assets_compile", "experience_game_assets_publish"]
    },
    {
      "type": "tool",
      "implementation": "gideon.workspace.capabilities.experience.moltworld_provider:create_provider",
      "capabilities": ["experience_moltworld_get", "experience_moltworld_configure", "experience_moltworld_status", "experience_moltworld_observe", "experience_moltworld_action"]
    }
  ]
}
